# Override of the libselinux PKGBUILD from archlinuxhardened/selinux, copied
# over the upstream directory by scripts/build-selinux.sh.
#
# The only difference from upstream is the patch added below and the prepare()
# that applies it: libselinux 3.10 does not build against the Python currently
# in Arch. pkgrel is one ahead of upstream's so a machine that installed the
# unpatched build upgrades to this one. Move it again, not back, if upstream
# reaches the same pkgrel.
#
# Delete this whole directory the moment archlinuxhardened ships a libselinux
# that builds as-is; pkgbuilds/selinux.manifest is where the pin moves.
#
# Maintainer MatricalDefunkt <dev <at> matricaldefunkt <dot> me>
# Maintainer: Nicolas Iooss (nicolas <dot> iooss <at> m4x <dot> org)
# Contributor: Timothée Ravier <tim@siosm.fr>
# Contributor: Nicky726 (Nicky726 <at> gmail <dot> com)
# Contributor: Sergej Pupykin (pupykin <dot> s+arch <at> gmail <dot> com)
# Contributor: Zezadas

pkgname=libselinux
pkgver=3.10
pkgrel=2
pkgdesc="SELinux library and simple utilities"
arch=('i686' 'x86_64' 'armv6h' 'aarch64')
url='https://github.com/SELinuxProject/selinux'
license=('libselinux-1.0')
groups=('selinux')
makedepends=('pkgconf' 'python' 'python-pip' 'python-setuptools' 'ruby' 'xz' 'swig')
depends=('libsepol>=3.10' 'pcre2')
optdepends=('python: python bindings'
            'ruby: ruby bindings')
conflicts=("selinux-usr-${pkgname}")
provides=("selinux-usr-${pkgname}=${pkgver}-${pkgrel}")
validpgpkeys=(
  '63191CE94183098689CAB8DB7EF137EC935B0EAF'  # Jason Zaman <perfinion@gentoo.org>
  '68D21823342A13683AEB3E4EFB4C685B5DC1C13E'  # Petr Lautrbach <lautrbach@redhat.com>
)
source=("https://github.com/SELinuxProject/selinux/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz"{,.asc}
        "libselinux.tmpfiles.d"
        "0001-python-3.14-PyUnicode_FromString.patch")
sha256sums=('1ef216c5b56fb7e0a51cd2909787a175a17ee391e0467894807873539ebe766b'
            'SKIP'
            'afe23890fb2e12e6756e5d81bad3c3da33f38a95d072731c0422fbeb0b1fa1fc'
            'feabb8a6b07baeeb483d80b5d5b6d33d3f75adf41187e5319f611849f0942815')

prepare() {
  cd "${pkgname}-${pkgver}"
  # Before `make swigify` in build(), which regenerates the wrapper from this
  # interface file.
  patch -p1 -i "${srcdir}/0001-python-3.14-PyUnicode_FromString.patch"
}

build() {
  cd "${pkgname}-${pkgver}"

  # Do not build deprecated rpm_execcon() interface. It is useless on Arch Linux anyway.
  export DISABLE_RPM=y

  # Use pcre2 explicitely even though it is the default since
  # https://github.com/SELinuxProject/selinux/commit/e0da140d82c0ebebf1060ce87d0f11276c7fc59a
  export USE_PCRE2=y

  export CFLAGS="${CFLAGS} -fno-semantic-interposition"
  make swigify
  make all
  make PYTHON=/usr/bin/python3 pywrap
  make RUBY=/usr/bin/ruby rubywrap
}

package() {
  provides+=(
    libselinux.so
  )

  cd "${pkgname}-${pkgver}"

  export DISABLE_RPM=y

  make DESTDIR="${pkgdir}" SBINDIR=/usr/bin SHLIBDIR=/usr/lib install
  make DESTDIR="${pkgdir}" PYTHON=/usr/bin/python3 SBINDIR=/usr/bin SHLIBDIR=/usr/lib install-pywrap
  make DESTDIR="${pkgdir}" RUBY=/usr/bin/ruby SBINDIR=/usr/bin SHLIBDIR=/usr/lib install-rubywrap
  # distutils was removed in Python 3.12; sysconfig's platlib is the same path.
  /usr/bin/python3 -m compileall "${pkgdir}/$(/usr/bin/python3 -c 'import sysconfig; print(sysconfig.get_path("platlib"))')"

  install -Dm 0644 "${srcdir}"/libselinux.tmpfiles.d "${pkgdir}"/usr/lib/tmpfiles.d/libselinux.conf

  install -Dm 0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
