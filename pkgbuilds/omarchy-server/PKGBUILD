# Maintainer: Zodo <edimar@quave.com.br>
#
# Server counterpart of the omarchy runtime package. Same layout as upstream
# (see docs/packaging.md):
#   /usr/share/omarchy/{bin,install,migrations,version}
#   /usr/bin/omarchy-*                        one entry per command in bin/
#   /etc/skel/.local/state/omarchy/migrations one stub per migration
#   /usr/share/libalpm/hooks/*.hook
#
# Differences from upstream omarchy 4.0.2:
#   - themes/ (120 MiB of 126) and shell/ (Quickshell) are not shipped.
#   - /usr/bin entries are symlinks into /usr/share/omarchy/bin instead of
#     byte copies, which halves the shipped command tree.
#   - two of the three libalpm hooks are dropped (Hyprland config reload).
#   - the desktop dependencies are gone and the runtime depends are cut to
#     what a headless machine actually calls (see depends below).
#   - install/server/ is added and omarchy-apply-system is patched to use it.
#   - bin/omarchy-server-addon and install/<profile>/addons/ add the opt-in
#     package sets that keep the base lean, per profile: install/server/addons/
#     for a server, install/router/addons/ first on a router.

pkgname=omarchy-server
pkgver=4.0.2
pkgrel=2
pkgdesc="Omarchy runtime for headless servers"
arch=('any')
url="https://github.com/basecamp/omarchy"
license=('MIT')
# Audited against the commands a server actually runs (update-*, pkg-*,
# version*, channel-*, snapshot, setup-security-*, migrate, apply-system,
# provision-*, refresh-*) and against install/server/*.sh:
#   gum             omarchy-update-confirm and omarchy-update-restart prompt
#                   with it, so an interactive `omarchy-update` needs it.
#   pacman-contrib  paccache, in omarchy-update-pkg-prune and in
#                   install/server/prune-pkg-cache-server.sh; and
#                   checkupdates, which omarchy-update-available and
#                   omarchy-server-motd ask "is there anything to install?".
#   arch-audit      `omarchy-server-update run --security-only` -- the daily
#                   update on this profile -- asks it which installed packages
#                   have an open advisory with a fix already published, and
#                   `omarchy-server-update status` reports that count whether
#                   or not the timer is on. It reads the local package
#                   database and security.archlinux.org and installs nothing
#                   itself: the answer is a list of names, and pacman acts on
#                   it. A hard depend rather than an optdepend because the
#                   security timer is half of what this profile promises a
#                   machine that is left alone.
#   fakeroot        checkupdates refreshes a throwaway copy of the sync
#                   databases as an unprivileged user, and does it by running
#                   pacman under fakeroot: without this it dies with "Cannot
#                   find the fakeroot binary" and every update check reports
#                   nothing to do. LD_PRELOAD plus a helper daemon in the same
#                   session -- no setuid bit, no capability, no privilege the
#                   caller did not already have.
# Everything else that used to be here is optional (below) or gone.
depends=(
  'omarchy-server-keyring'
  "omarchy-server-settings=${pkgver}"
  'limine'
  'limine-mkinitcpio-hook'
  'limine-snapper-sync'
  'snapper'
  'btrfs-progs'
  'gum'
  'pacman-contrib'
  'fakeroot'
  'arch-audit'
)
# Dropped from depends, with the reason each one is not required:
#   git       every call site is the dev-channel checkout path
#             (omarchy-update-dev, omarchy-channel-set) or a `|| true` version
#             probe (omarchy-version, omarchy-update-available). The `dev`
#             addon installs it.
#   jq        used by omarchy-cmd-terminal-cwd, which needs a terminal, and by
#             nothing on the update/install path.
#   perl      four theme and menu commands, none of which run headless.
optdepends=(
  'git: dev-channel checkout (omarchy-update-dev, omarchy-channel-set)'
  'jq: JSON handling in the desktop-oriented commands'
  'yay: install AUR packages with omarchy-pkg-aur-install'
  'docker: container runtime, installed by `omarchy-server-addon docker`'
  'ufw: firewall configured by install/server/firewall-server.sh'
  'tailscale: private network, installed by `omarchy-server-addon tailscale`'
)
makedepends=('git')
provides=('omarchy')
conflicts=('omarchy' 'omarchy-dev')

_commit=346e69e1cec6c4e8924531874af6ba010a1bc99e
# The default source is the public fork over https, which is what CI and any
# `makepkg` run outside this repository's build scripts get. A builder that
# already has a checkout (the lab repo's pkgs/build.sh bind mounts one at
# /src/omarchy, the ISO builder mounts one at /omarchy-source) exports
# OMARCHY_SRC and the build reads that instead, so no network and no ambient
# working-tree state. OMARCHY_GIT_URL overrides both.
: "${OMARCHY_GIT_URL:=${OMARCHY_SRC:+file://$OMARCHY_SRC}}"
: "${OMARCHY_GIT_URL:=https://github.com/edimarlnx/omarchy.git}"

source=("omarchy::git+${OMARCHY_GIT_URL}#commit=${_commit}"
        "omarchy-server-overlay.tar.gz")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd "$srcdir/omarchy"

  # Kept as patches rather than as replacement files so each change stays
  # readable on its own and rebases against upstream instead of silently
  # freezing a whole command at this commit.
  local patch
  for patch in "$srcdir"/overlay/patches/*.patch; do
    echo "Applying ${patch##*/}"
    patch -p1 --forward <"$patch"
  done
}

package() {
  local src="$srcdir/omarchy"
  local share="$pkgdir/usr/share/omarchy"

  install -d "$share"

  # --- the runtime tree ----------------------------------------------------
  cp -a "$src/bin" "$share/bin"
  cp -a "$src/install" "$share/install"
  cp -a "$src/migrations" "$share/migrations"

  # install/server/: the server profile's setup tree.
  cp -a "$srcdir/overlay/runtime/install/server" "$share/install/server"
  chmod 0644 "$share/install/server/"*.sh "$share/install/server/addons/"*.sh
  # install/server/mac/ carries the AppArmor profiles and the SELinux policy
  # sources the two MAC addons install. Data, not scripts.
  if [[ -d $share/install/server/mac ]]; then
    find "$share/install/server/mac" -type f -exec chmod 0644 {} +
  fi

  # install/router/: the router profile's setup tree. It reuses the server
  # leaves (router/all.sh sources install/server/*.sh directly) and adds only
  # the router-specific ones -- the WAN/LAN network, IP forwarding, the
  # nftables inet tui firewall and the router console identity. Shipped in this
  # package, not a separate one, because the router profile is the server
  # runtime with a router layered on; omarchy-apply-system routes to it when
  # OMARCHY_PROFILE=router. The .service is the headless provision-owner unit
  # the ISO copies for a deferred-provisioning router install.
  if [[ -d $srcdir/overlay/runtime/install/router ]]; then
    cp -a "$srcdir/overlay/runtime/install/router" "$share/install/router"
    chmod 0644 "$share/install/router/"*.sh "$share/install/router/"*.service
  fi

  # Addon package lists. They live in profile/server/addons/ because the ISO
  # builder reads the same files to bundle those packages in the offline
  # mirror; build.sh packs both directories into the overlay tarball so there
  # is one source of truth.
  install -d "$share/install/server/addons"
  install -Dm644 "$srcdir/addons/"*.packages -t "$share/install/server/addons"
  # Optional per-addon pacman flags, beside the package list they apply to.
  # `selinux` is the one addon that needs them: its packages replace packages
  # the base already has, and pacman will not resolve a conflict under plain
  # --noconfirm. omarchy-server-addon reads the file when it exists.
  if compgen -G "$srcdir/addons/*.pacman-args" >/dev/null; then
    install -Dm644 "$srcdir/addons/"*.pacman-args -t "$share/install/server/addons"
  fi

  # The ROUTER profile's addon lists, from profile/router/addons. The two
  # profiles do not offer the same sets -- a router adds `headscale` and its
  # `tui-tools` set carries the four router tools -- and omarchy-server-addon
  # reads install/<profile>/addons/ before install/server/addons/, so a machine
  # whose /etc/omarchy-profile says `router` gets the router lists and a server
  # is untouched. Only the lists: the setup and preflight leaves stay in
  # install/server/addons/ and are shared by both profiles.
  if [[ -d $srcdir/router-addons ]]; then
    install -d "$share/install/router/addons"
    install -Dm644 "$srcdir/router-addons/"*.packages -t "$share/install/router/addons"
    if compgen -G "$srcdir/router-addons/*.pacman-args" >/dev/null; then
      install -Dm644 "$srcdir/router-addons/"*.pacman-args -t "$share/install/router/addons"
    fi
    if compgen -G "$srcdir/router-addons/*.sh" >/dev/null; then
      install -Dm644 "$srcdir/router-addons/"*.sh -t "$share/install/router/addons"
    fi
  fi

  # Commands this profile adds on top of upstream's bin/, copied in before the
  # /usr/bin symlink loop below so they are linked like any other command.
  install -Dm755 "$srcdir/overlay/runtime/bin/"* -t "$share/bin"

  # System units this profile adds. They live here rather than in the settings
  # package because the commands they run are in this one, and a unit whose
  # ExecStart is owned by a different package is a dependency waiting to be
  # forgotten. install/server/enable-services-server.sh enables the palette
  # oneshot; the three update timers -- the weekly full update, the daily
  # security-only update and the one that takes a deferred reboot at the start
  # of the reboot window -- all ship disabled and are turned on together by
  # `omarchy-server-update enable` or by an autoinstall drive that carries an
  # `unattended-updates` file.
  install -Dm644 "$srcdir/overlay/runtime/systemd/"*.service \
    "$srcdir/overlay/runtime/systemd/"*.timer \
    -t "$pkgdir/usr/lib/systemd/system"

  # Upstream ships the repo's own `version` file, which on a development
  # checkout does not match pkgver. Write pkgver so `cat version` and
  # `pacman -Q omarchy-server` agree; omarchy-version reads the latter.
  echo "$pkgver" >"$share/version"
  chmod 0644 "$share/version"

  # --- /usr/bin ------------------------------------------------------------
  # One symlink per command. Every omarchy-* command is shipped, including the
  # ones that only make sense with a compositor: curating 440 commands is a
  # separate job with its own regression risk, and a dangling desktop command
  # simply fails when run. docs/packaging.md lists which groups are
  # desktop-only.
  install -d "$pkgdir/usr/bin"
  local command
  for command in "$share/bin/"*; do
    ln -sf "/usr/share/omarchy/bin/${command##*/}" "$pkgdir/usr/bin/${command##*/}"
  done

  # --- pacman hooks --------------------------------------------------------
  # Only the update guard. The Hyprland reload hooks have no compositor.
  install -Dm644 "$src/default/libalpm/hooks/00-omarchy-update-guard.hook" \
    "$pkgdir/usr/share/libalpm/hooks/00-omarchy-update-guard.hook"

  # --- migration stubs -----------------------------------------------------
  # A fresh user must not replay the whole migration history, so every
  # migration is pre-marked as done in /etc/skel. Same as upstream.
  local skel_migrations="$pkgdir/etc/skel/.local/state/omarchy/migrations"
  install -d "$skel_migrations"
  local migration
  for migration in "$src/migrations/"*.sh; do
    [[ -e $migration ]] || continue
    : >"$skel_migrations/${migration##*/}"
    chmod 0644 "$skel_migrations/${migration##*/}"
  done

  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
