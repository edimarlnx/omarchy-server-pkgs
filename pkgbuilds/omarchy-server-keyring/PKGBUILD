# Maintainer: Zodo <edimar@quave.com.br>
#
# Distributes the public key that signs the [omarchy-server] pacman repository,
# laid out the way archlinux-keyring and omarchy-keyring are:
#   /usr/share/pacman/keyrings/<name>.gpg      exported public keys
#   /usr/share/pacman/keyrings/<name>-trusted  fingerprint:ownertrust
#   /usr/share/pacman/keyrings/<name>-revoked  fingerprints to revoke
# `pacman-key --populate omarchy-server` imports the .gpg, applies the trust
# levels from -trusted and revokes anything listed in -revoked.
#
# The key currently packaged is a LAB key generated by pkgs/keys/gen-lab-key.sh
# (kept out of git). Replacing it with a real, offline-generated key is a
# matter of dropping the exported .gpg and the new fingerprint in -trusted
# here: nothing else in the three packages refers to the key material.
# See docs/packaging.md.

pkgname=omarchy-server-keyring
pkgver=20260828
pkgrel=1
pkgdesc="Omarchy Server keyring (public key of the [omarchy-server] repository)"
arch=('any')
url="https://github.com/edimarlnx/omarchy-server-pkgs"
license=('GPL-3.0-or-later')
install="${pkgname}.install"
source=("omarchy-server.gpg"
        "omarchy-server-trusted"
        "omarchy-server-revoked")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
  install -Dm644 "$srcdir/omarchy-server.gpg" \
    "$pkgdir/usr/share/pacman/keyrings/omarchy-server.gpg"
  install -Dm644 "$srcdir/omarchy-server-trusted" \
    "$pkgdir/usr/share/pacman/keyrings/omarchy-server-trusted"
  install -Dm644 "$srcdir/omarchy-server-revoked" \
    "$pkgdir/usr/share/pacman/keyrings/omarchy-server-revoked"
}
