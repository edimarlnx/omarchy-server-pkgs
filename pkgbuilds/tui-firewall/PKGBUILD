# Maintainer: Zodo <edimar@quave.com.br>
#
# tui-firewall — a terminal UI for the system firewall
# (https://github.com/tui-tools/tui-firewall). It reads the live ufw state and
# previews the exact command line of every change before running it.
#
# Formerly `fwall`, in the edimarlnx/tui-tools monorepo. The tool now has a
# repository of its own under the tui-tools organization; `provides`/`replaces`
# below are what upgrades a machine that installed the old name.
#
# This is an ADDON package: it is bundled in the ISO's offline mirror and
# installed by `omarchy-server-addon tui-firewall`, never by the base profile.
# The server core is what a headless machine needs to boot, update, snapshot,
# be reached and be firewalled — a TUI over the firewall is a convenience for
# the machines somebody works on, and convenience is what addons are for.

pkgname=tui-firewall
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal UI for the system firewall (ufw)"
arch=('x86_64')
url="https://github.com/tui-tools/tui-firewall"
license=('MIT')
# Nothing: CGO_ENABLED=0 makes the binary fully static, and tui-firewall shells
# out to ufw rather than linking anything. A tool that says "no backend found"
# is the right behaviour on a machine where ufw was removed.
depends=()
optdepends=('ufw: the firewall backend the default configuration drives'
            'sudo: privilege escalation, unless tui-firewall is started as root')
makedepends=('git' 'go')
backup=('etc/tui-firewall/config.toml')
# The tool this package used to be called. `provides` so anything asking for
# the old name is satisfied, `replaces` so `pacman -Syu` on a machine that has
# fwall installed swaps it for this package instead of leaving both.
provides=('fwall')
replaces=('fwall')
# The ldflags above already drop the symbol and DWARF tables, so makepkg's
# debug package would be an empty shell and its strip pass has nothing to do.
options=('!debug' '!strip')

# The upstream release tag, consumed the same way the omarchy-server packages
# consume their pinned commit: the public repository over https by default, and
# a local checkout when the builder mounts one and exports TUI_FIREWALL_SRC
# (/src/tui-firewall for the lab repo's pkgs/build.sh,
# /omarchy-pkgs/src/tui-firewall inside the ISO builder). TUI_FIREWALL_GIT_URL
# overrides both. A tag rather than a raw commit because upstream releases are
# tagged and pkgver has to mean something; the tag is annotated and unmoving.
_tag=v0.1.0
: "${TUI_FIREWALL_GIT_URL:=${TUI_FIREWALL_SRC:+file://$TUI_FIREWALL_SRC}}"
: "${TUI_FIREWALL_GIT_URL:=https://github.com/tui-tools/tui-firewall.git}"

source=("$pkgname::git+${TUI_FIREWALL_GIT_URL}#tag=${_tag}")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  # Modules are fetched here rather than in build() so the compile step itself
  # is offline, and go.sum makes the download reproducible.
  export GOPATH="$srcdir/gopath"
  go mod download
}

build() {
  cd "$srcdir/$pkgname"
  export GOPATH="$srcdir/gopath"
  export CGO_ENABLED=0
  export GOFLAGS="-mod=readonly -modcacherw"
  # -trimpath strips the build directory out of the binary so two builds of the
  # same commit produce the same bytes. -s -w drop the symbol and DWARF tables:
  # this is a TUI, not something anybody profiles on the target.
  go build -trimpath -ldflags "-s -w -X main.version=${pkgver}" \
    -o "$srcdir/$pkgname.bin" "./cmd/$pkgname"
}

check() {
  cd "$srcdir/$pkgname"
  export GOPATH="$srcdir/gopath"
  export CGO_ENABLED=0
  export GOFLAGS="-mod=readonly -modcacherw"
  go test ./...
}

package() {
  local src="$srcdir/$pkgname"

  install -Dm755 "$srcdir/$pkgname.bin" "$pkgdir/usr/bin/$pkgname"

  # The machine-wide configuration tui-firewall reads first:
  # /etc/tui-firewall/config.toml, then ~/.config/tui-firewall/config.toml. The
  # shipped example says backend = "auto"; this profile pins it to ufw, which
  # is the firewall install/server/firewall-server.sh configures and the only
  # one the server package list can produce.
  sed -e 's/^backend = "auto"$/backend = "ufw"/' \
    "$src/examples/config.toml" >"$srcdir/config.toml"
  grep -q '^backend = "ufw"$' "$srcdir/config.toml" ||
    { echo "config.toml: backend was not pinned to ufw" >&2; return 1; }
  install -Dm644 "$srcdir/config.toml" "$pkgdir/etc/$pkgname/config.toml"

  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
