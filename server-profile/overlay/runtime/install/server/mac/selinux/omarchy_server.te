########################################################################
# omarchy_server — the local SELinux policy of the server profile.
#
# Compiled on the machine by install/server/selinux-server.sh with
# `checkmodule -m` + `semodule_package`, which is plain module syntax and
# exactly what `audit2allow -M` emits. Not refpolicy macro syntax: that would
# need make and m4 on a production server to build forty lines of policy.
#
# EVERY RULE HERE COMES FROM A DENIAL THAT WAS MEASURED ON THIS PROFILE, in
# reports/2026-08-29-mandatory-access-control.md. Nothing is here because it
# seemed likely. Each block says which denial it answers and why allowing it is
# right rather than merely quieting — and where a measured denial is answered
# with `dontaudit` instead, why the thing being asked for is not needed. Rule
# 16 records the one place where the rule was written wider than the
# measurement, and says so.
#
# Four shapes, and nothing else:
#
#   * the gap between refpolicy 20250923 and systemd 261 / OpenSSH 10.5 —
#     credentials on tmpfs, PSI, userdb, varlink, BPF (rules 1-15);
#   * the standard streams a privileged command inherits from the session that
#     ran it, which is what makes a non-interactive `ssh host sudo …` run
#     correctly and print nothing (rule 16, and the domains that share it);
#   * capabilities and requests that are asked for, refused, and not missed —
#     answered with `dontaudit` rather than a grant (17, 21, 25, 31, 38);
#   * the paths only a CLOUD IMAGE takes, where cloud-init creates every
#     account, home directory and ssh key on the first boot and the machine
#     grows into a disk it was not built on (rules 26-39,
#     reports/2026-08-29-cloud-image-selinux.md).
#
# None of them is a rule that lets a confined domain reach something it has no
# business in.
#
# NOT here, deliberately: sshd's access to /var/lib/lastlog/lastlog2.db, which
# produced eight of the eighteen boot denials. Widening sshd_t over all of
# var_lib_t to reach one database would be the wrong repair. The path is
# labelled lastlog_t instead, in local-fcontexts, and refpolicy's existing
# sshd rules for lastlog_t then apply unchanged. Label the object, do not
# widen the subject.
########################################################################

module omarchy_server 1.0;

require {
	attribute daemon;
	attribute domain;
	attribute systemd_user_session_type;
	attribute unpriv_userdomain;
	attribute filesystem_type;
	type systemd_generator_t;
	type systemd_tmpfiles_t;
	type auditd_etc_t;
	type shadow_t;
	type lastlog_t;
	type bin_t;
	type selinux_config_t;
	type sysctl_fs_t;
	type mount_runtime_t;
	type etc_runtime_t;
	type loadkeys_t;
	type sysfs_t;
	type gpg_runtime_t;
	type init_t;
	type systemd_sysusers_t;
	type modules_object_t;
	type tmp_t;
	type user_sudo_t;
	type user_t;
	type sysadm_t;
	type staff_sudo_t;
	type dockerc_t;
	type initrc_t;
	type setfiles_t;
	type systemd_notify_t;
	type dosfs_t;
	type semanage_t;
	type systemd_sysusers_exec_t;
	role sysadm_r;
	type file_context_t;
	type policy_config_t;
	type semanage_store_t;
	type proc_t;
	type user_tmp_t;
	type user_home_t;
	type load_policy_t;
	type getty_t;
	type gpg_t;
	type nsfs_t;
	type system_dbusd_t;
	type systemd_resolved_t;
	type systemd_networkd_t;
	type syslogd_t;
	type tmpfs_t;
	type cgroup_t;
	type sshd_t;
	type systemd_logind_t;
	type systemd_user_runtime_dir_t;
	type systemd_userdbd_t;
	type systemd_userdbd_runtime_t;
	type kmod_t;
	type httpd_lock_t;
	type initrc_lock_t;
	# The image path: cloud-init, the machine it provisions, and the domains a
	# first boot from a shared image walks that an install never does
	# (rules 26-39).
	attribute systemdunit;
	type staff_t;
	type cloud_init_t;
	type cloud_init_runtime_t;
	type cloud_init_state_t;
	type sysctl_vm_t;
	type sysctl_vm_overcommit_t;
	type user_home_dir_t;
	type ssh_home_t;
	type initrc_tmp_t;
	type init_runtime_t;
	type fsadm_t;
	type node_t;
	type udev_runtime_t;
	type mount_t;
	type useradd_t;
	type xdg_config_t;
	type xdg_data_t;
	type git_xdg_config_t;
	type systemd_unit_t;
	type virtio_device_t;
	type kernel_t;
	type sshd_key_t;
	class dir { search read open getattr write add_name remove_name create relabelfrom relabelto setattr };
	class bpf { prog_load prog_run map_create map_read map_write };
	class capability2 bpf;
	class capability { net_admin dac_read_search sys_admin audit_write };
	class filesystem { quotaget quotamod associate getattr };
	class netlink_audit_socket { create read write nlmsg_relay };
	class netlink_tcpdiag_socket { create bind read write getattr setopt nlmsg_read };
	class file { getattr read write open ioctl create unlink rename map append lock relabelfrom relabelto execute entrypoint link };
	class lnk_file { read getattr };
	class fifo_file { append getattr ioctl lock read write };
	class sock_file { write create getattr unlink };
	class system { status module_request };
	class service status;
	class tcp_socket node_bind;
	class process { transition siginh rlimitinh noatsecure getsched };
	class unix_stream_socket { connectto create listen setopt bind read write ioctl };
	class chr_file getattr;
	class fd use;
}

########################################################################
# 1. The generators read /etc/selinux/config, which is a symlink.
#
#   comm="systemd-fstab-g" name="config" tclass=lnk_file
#     scontext=systemd_generator_t tcontext=selinux_config_t
#
# systemd's generators call libselinux at startup, which stats
# /etc/selinux/config to find out whether SELinux is enabled and which policy
# to use. On this profile that path is a SYMLINK to config.refpolicy-arch --
# the policy package ships it that way and the addon keeps it -- and refpolicy
# grants generators the file, not the link. Reading the link is how any
# SELinux-aware process bootstraps; refusing it just makes the generator
# behave as if SELinux were off.
#
# Against the `domain` attribute, and that is the third widening of this rule
# rather than the first. It started as systemd_generator_t, because that was
# the only thing that had tripped it; the next boot added systemd-networkd, so
# it became `daemon`; a later run added systemd-tty-ask-password-agent, which
# is not a daemon either. The pattern is not "these processes", it is "anything
# linked against libselinux, at startup", which is the definition of `domain`
# on a machine where the whole userland was rebuilt against libselinux.
#
# What it grants is `read` on ONE symlink, whose content is the string
# "config.refpolicy-arch". The file it points at is a separate permission the
# policy still governs, and refusing the link only makes the reader behave as
# if SELinux were off.
########################################################################
allow domain selinux_config_t:lnk_file read;

########################################################################
# 1b. A generator reads /proc/sys/fs/nr_open.
#
#   comm="(mkfs)" path="/proc/sys/fs/nr_open" tclass=file
#     { getattr read open ioctl } scontext=systemd_generator_t
#     tcontext=sysctl_fs_t
#
# systemd raises its own file-descriptor limit before forking a generator, and
# reads the kernel's ceiling to know how far it may go. A read-only sysctl that
# says how many files this kernel allows; there is nothing to leak in it.
########################################################################
allow systemd_generator_t sysctl_fs_t:file { getattr read open ioctl };

########################################################################
# 1c. resolved asks networkd for the current link configuration.
#
#   comm="systemd-resolve" path="/run/systemd/resolve.hook/io.systemd.Network"
#     tclass=unix_stream_socket connectto tcontext=systemd_networkd_t
#   comm="systemd-network" name="mount" tclass=dir search
#     tcontext=mount_runtime_t
#
# The same varlink migration as rule 4: systemd 261 has resolved talk to
# networkd over a varlink hook socket rather than over D-Bus, and refpolicy
# describes the D-Bus arrangement. Without it resolved does not learn the DNS
# servers networkd got from DHCP.
########################################################################
allow systemd_resolved_t systemd_networkd_t:unix_stream_socket connectto;
allow systemd_networkd_t mount_runtime_t:dir search;

########################################################################
# 2. systemd credentials live on a tmpfs the policy has no name for.
#
#   comm="systemd-network" path="/run/credentials/systemd-network-generator.service"
#     tclass=dir { read open } tcontext=tmpfs_t
#   comm="systemd-journal"  name="/" tclass=dir { search } tcontext=tmpfs_t
#
# systemd 261 mounts a private tmpfs per unit under /run/credentials/<unit>
# and hands the unit its credentials there. The kernel labels a tmpfs root at
# mount time and refpolicy 20250923 predates the mechanism, so the mount point
# is plain tmpfs_t and every unit that reads its own credentials is denied.
#
# Against the `daemon` attribute and the getty domain, after the same lesson as
# rule 3: the first boot showed networkd and journald, a later one showed
# agetty reading /run/credentials/getty@tty1.service. Credentials are a
# per-unit systemd mechanism, so the set of domains that use them is "whichever
# units are configured with them" -- an enumeration that would grow with every
# unit added.
#
# Directory traversal only, not the files inside. A domain that may enter the
# directory still needs a rule for what it finds there, which is the policy
# working as intended.
########################################################################
allow daemon tmpfs_t:dir { search read open getattr };
allow getty_t tmpfs_t:dir { search read open getattr };

########################################################################
# 3. Every systemd service reads its own cgroup's pressure file.
#
#   comm="systemd-journal" path="/sys/fs/cgroup/system.slice/
#     systemd-journald.service/memory.pressure"
#     tclass=file { getattr read write open } tcontext=cgroup_t
#   ... and the same, verbatim, for systemd-userdbd, systemd-timesyncd and
#   systemd-resolved on the next boot.
#
# systemd registers each service for kernel PSI notifications so it can shed
# load when the machine is under memory pressure. Opening memory.pressure
# read-write is how a poll registration is made -- the write is the
# registration, not a change to the cgroup's limits, which live in different
# files. refpolicy 20250923 grants daemons their cgroup directory but not this
# file.
#
# Written against the `daemon` ATTRIBUTE rather than per domain, and that is a
# deliberate widening. The first version of this module named syslogd_t alone,
# because journald was the only service that had tripped it in that boot; the
# next boot produced the identical denial for three more domains. The pattern
# is not "journald does something unusual", it is "systemd does this for every
# unit", so enumerating domains would be an open-ended list that grows every
# time a service is added.
#
# The honest cost: this grants every daemon domain read-write on cgroup_t
# FILES, not just its own memory.pressure -- SELinux labels the whole cgroup
# hierarchy cgroup_t, so the policy has no way to say "its own". Narrower would
# require the policy to type-transition per-unit cgroups, which refpolicy does
# not do. Recorded here so nobody has to rediscover why the rule is this shape.
########################################################################
allow daemon cgroup_t:file { getattr read write open };
# The directory the pressure file lives in, for the same reason and the same
# domains. Traversal and listing only; no add_name, no remove_name, no write.
allow daemon cgroup_t:dir { search read open getattr };

########################################################################
# 4. sshd talks to logind over varlink.
#
#   comm="sshd-session" path="/run/systemd/io.systemd.Login"
#     tclass=unix_stream_socket connectto tcontext=systemd_logind_t
#
# pam_systemd registers the new session with logind. systemd 261 moved that
# conversation from D-Bus to a varlink socket, and refpolicy's sshd rules still
# describe the D-Bus path. Without this there is no logind session for an ssh
# login: no /run/user/<uid>, no session scope, no session tracking.
#
# This is the same conversation the policy already intends to allow, over a
# different transport.
########################################################################
allow sshd_t systemd_logind_t:unix_stream_socket connectto;

########################################################################
# 5. systemd-user-runtime-dir asks userdb who the user is.
#
#   comm="systemd-user-ru" name="io.systemd.Multiplexer"
#     tclass=sock_file write tcontext=systemd_userdbd_runtime_t
#   comm="systemd-user-ru" path="/run/systemd/userdb/io.systemd.Multiplexer"
#     tclass=unix_stream_socket connectto tcontext=systemd_userdbd_t
#
# systemd-user-runtime-dir@<uid>.service creates /run/user/<uid> and resolves
# the user through systemd-userdbd's multiplexer socket rather than through
# NSS directly. Two denials for one operation: writing the socket file and
# connecting to the daemon behind it.
#
# Both target systemd-userdbd specifically, which is the one service whose
# entire purpose is answering this question.
########################################################################
allow systemd_user_runtime_dir_t systemd_userdbd_runtime_t:sock_file write;
allow systemd_user_runtime_dir_t systemd_userdbd_t:unix_stream_socket connectto;

########################################################################
# 6. sshd reaches the lastlog database's DIRECTORY.
#
#   comm="sshd-session" name="lastlog" tclass=dir { search getattr }
#     tcontext=lastlog_t
#
# The companion to the /var/lib/lastlog fcontext in local-fcontexts. refpolicy
# knows lastlog_t as a FILE -- /var/log/lastlog was a single sparse file --
# and grants sshd_t what it needs on it. shadow's lastlog2 is a DIRECTORY
# holding lastlog2.db, so labelling the path correctly still leaves sshd unable
# to enter it. One rule, on the type this profile just assigned, for the domain
# that already has the file permissions.
########################################################################
#
# The full set, and it is wider than a "read a database" rule looks: lastlog2
# is SQLite, so every login creates and removes a lastlog2.db-journal beside
# the database. That is add_name/remove_name/write on the directory and
# create/unlink on the file -- write access to one directory this profile
# labelled itself, which is the narrowest form this can take.
allow sshd_t lastlog_t:dir { search getattr read open write add_name remove_name };
allow sshd_t lastlog_t:file { create unlink };

########################################################################
# 7. systemd-tmpfiles stats paths that belong to other subsystems.
#
#   comm="systemd-tmpfile" name="profile.d"   tclass=dir  { search } tcontext=bin_t
#   comm="systemd-tmpfile" name="80-systemd-osc-context.sh"
#                                             tclass=lnk_file { read } tcontext=bin_t
#   comm="systemd-tmpfile" path="/etc/profile.d/locale.sh"
#                                             tclass=file { getattr } tcontext=bin_t
#   comm="systemd-tmpfile" path="/etc/gshadow" tclass=file { getattr } tcontext=shadow_t
#   comm="systemd-tmpfile" name="audit"       tclass=dir  { search } tcontext=auditd_etc_t
#   comm="systemd-tmpfile" path="/etc/audit/audit-stop.rules"
#                                             tclass=file { getattr } tcontext=auditd_etc_t
#
# systemd-tmpfiles walks every path named in tmpfiles.d and stats it to decide
# whether the ownership and mode already match. Stat-ing a path it is told
# about is the entire job; refpolicy grants it most of /etc but not these three
# types. /etc/profile.d is bin_t because the policy correctly treats shell
# fragments as programs.
#
# getattr and read only -- no write, no create, no unlink. tmpfiles here is
# checking, not changing, and if it ever needs to change one of these the
# denial should be seen rather than pre-granted.
########################################################################
allow systemd_tmpfiles_t bin_t:dir search;
allow systemd_tmpfiles_t bin_t:file getattr;
allow systemd_tmpfiles_t bin_t:lnk_file { read getattr };
allow systemd_tmpfiles_t shadow_t:file getattr;
allow systemd_tmpfiles_t auditd_etc_t:dir search;
allow systemd_tmpfiles_t auditd_etc_t:file getattr;

########################################################################
# 8. systemd-user-runtime-dir reads /etc/machine-id.
#
#   comm="systemd-user-ru" path="/etc/machine-id" tclass=file { read open }
#     tcontext=etc_runtime_t
#
# The per-user runtime directory is keyed by the machine id. Reading the file
# whose entire purpose is to be read by everything on the system.
########################################################################
allow systemd_user_runtime_dir_t etc_runtime_t:file { read open getattr };

########################################################################
# 9. loadkeys writes the keymap it just decompressed into a memfd.
#
#   comm="loadkeys" path=<hex>"/memfd:/usr/share/kbd/keymaps/i386/qwerty/
#     us.map.gz (deleted)" tclass=file { write getattr } tcontext=tmpfs_t
#
# The console keymap ships gzipped; loadkeys decompresses it into an anonymous
# memfd, which the kernel labels tmpfs_t because that is what a memfd is. It is
# writing to its own memory. refpolicy predates systemd-vconsole-setup taking
# this route.
########################################################################
allow loadkeys_t tmpfs_t:file { write getattr };
# systemd-networkd does the same thing for a different reason: it serialises
# its own state into a memfd across a reload
# (path="memfd:serialization (deleted)"). Same mechanism, same anonymous
# memory, same type from the kernel. Enumerated rather than widened to the
# `daemon` attribute, because tmpfs_t is also what /dev/shm entries carry and
# "every daemon may read every daemon's shared memory" is a larger statement
# than these two memfds justify.
allow systemd_networkd_t tmpfs_t:file { read write getattr };

########################################################################
# 10. networkd loads its own BPF programs.
#
#   comm="systemd-network" tclass=bpf { prog_load prog_run map_create
#     map_read map_write } scontext=tcontext=systemd_networkd_t
#   comm="systemd-network" capability=39 (CAP_BPF) tclass=capability2
#   comm="systemd-network" path="/sys/kernel/btf/vmlinux" tclass=file { map }
#     tcontext=sysfs_t
#
# systemd-networkd implements per-interface ingress/egress filtering and
# BPFProgram= with BPF, and reads /sys/kernel/btf/vmlinux to relocate the
# program against this kernel. refpolicy 20250923 has no bpf class rules for
# networkd at all.
#
# The widest rule in this module, and the one to revisit first: CAP_BPF plus
# prog_load is real capability. It is scoped to networkd acting on ITSELF
# (scontext == tcontext), which is as narrow as the bpf class allows, and the
# alternative is a network manager that cannot configure the interfaces it
# exists to configure. If this profile ever stops using systemd-networkd, this
# block goes with it.
########################################################################
allow systemd_networkd_t self:bpf { prog_load prog_run map_create map_read map_write };
allow systemd_networkd_t self:capability2 bpf;
allow systemd_networkd_t sysfs_t:file map;

########################################################################
# 11. The per-user systemd instance sets up /run/user/<uid>.
#
#   comm="systemd" name="gnupg" tclass=dir { create write add_name }
#     scontext=user_systemd_t tcontext=gpg_runtime_t
#   comm="systemd" path="/run/systemd/oom/io.systemd.ManagedOOM"
#     tclass=unix_stream_socket connectto tcontext=init_t
#   comm="systemd-user-ru" tclass=filesystem { quotaget quotamod }
#     tcontext=tmpfs_t
#   comm="systemd-user-ru" tclass=dir read tcontext=tmp_t
#
# These are on the LOGIN PATH, which is why they matter more than the rest of
# this module: `omarchy-server-selinux enforcing` blocks on any denial raised
# by the user role, and it did block on exactly these. A user manager that
# cannot create its own runtime directories is a broken login, not a degraded
# service.
#
# What each one is: systemd --user runs the tmpfiles rules that create
# /run/user/<uid>/gnupg; it registers with the system manager's ManagedOOM
# varlink socket; and systemd-user-runtime-dir sets the tmpfs size quota on the
# runtime directory it just mounted, which is what quotaget/quotamod are here.
# All four are the user manager operating on the user's own runtime tree.
#
# Against the `systemd_user_session_type` ATTRIBUTE, not against
# user_systemd_t, and that is a measured correction rather than a precaution.
# The per-user manager's domain follows the SELinux user's prefix: a session
# mapped to user_u runs it as user_systemd_t, one mapped to staff_u runs it as
# staff_systemd_t. When this profile gained its administrative role (§16) and
# the operator became staff_u, all six of these denials came back verbatim
# under the new domain. The attribute holds user_systemd_t, staff_systemd_t and
# sysadm_systemd_t, which is exactly the set this rule is about: "the systemd
# --user instance, whoever it belongs to".
########################################################################
allow systemd_user_session_type gpg_runtime_t:dir { create write add_name search read open getattr };
allow systemd_user_session_type init_t:unix_stream_socket connectto;
allow systemd_user_runtime_dir_t tmpfs_t:filesystem { quotaget quotamod };
allow systemd_user_runtime_dir_t tmp_t:dir read;

########################################################################
# 12. sudo and the user shell need two capabilities.
#
#   scontext=tcontext=user_sudo_t tclass=capability { net_admin }
#   scontext=tcontext=user_t      tclass=capability { dac_read_search }
#
# net_admin is `ufw status verbose` under sudo -- reading the firewall means
# talking to netfilter. dac_read_search is the user shell traversing a
# directory it owns but whose mode would otherwise refuse it, which is what
# every `sudo`-adjacent tool does when it stats a path under /var.
#
# Both are the capability the operator already has by being in the sudo group;
# SELinux is a second gate on the same action, and this opens only that second
# gate for those two domains.
########################################################################
allow user_sudo_t self:capability net_admin;
allow user_t self:capability dac_read_search;

########################################################################
# 13. The remaining early-boot tmpfiles and sysusers gaps.
#
#   comm="systemd-tmpfile" name="modules" tclass=dir search
#     tcontext=modules_object_t
#   comm="systemd-tmpfile" path="/run/initramfs/mkinitcpio-shutdown.conf"
#     tclass=dir { write add_name } / file { create write open }
#     tcontext=tmpfs_t
#   comm="systemd-sysusers" tclass=netlink_audit_socket create
#   comm="loadkeys" tclass=file read tcontext=tmpfs_t
#
# mkinitcpio ships a tmpfiles rule that writes its shutdown configuration into
# /run/initramfs, which is a tmpfs; the modules directory search is the same
# walk over /usr/lib/modules. systemd-sysusers opens a netlink audit socket to
# record the accounts it creates -- refusing that would silence an audit
# record, which is the wrong direction. loadkeys needs read as well as the
# write already granted in rule 9: it decompresses into the memfd and then
# reads it back.
########################################################################
allow systemd_tmpfiles_t modules_object_t:dir search;
allow systemd_tmpfiles_t tmpfs_t:dir { write add_name };
allow systemd_tmpfiles_t tmpfs_t:file { create write open getattr };
allow systemd_sysusers_t self:netlink_audit_socket create;
allow loadkeys_t tmpfs_t:file read;

########################################################################
# 14. The user manager socket-activates gpg-agent.
#
#   comm="systemd" tclass=unix_stream_socket { create listen setopt }
#     scontext=user_systemd_t tcontext=gpg_t
#   comm="..." tclass=file getattr scontext=user_t tcontext=nsfs_t
#
# systemd --user owns gpg-agent's listening sockets so it can start the agent
# on first use; creating and listening on a socket that will belong to gpg_t is
# the whole of socket activation. Also on the login path, so it blocks
# `enforcing` until it is allowed.
#
# nsfs_t is /proc/<pid>/ns/*: a namespace link the shell stats. getattr only.
########################################################################
#
# On the attribute, for the same reason as rule 11: the domain is the per-user
# manager's, and which one it is depends on whether the session was mapped to
# user_u or to staff_u.
allow systemd_user_session_type gpg_t:unix_stream_socket { create listen setopt bind };
# nsfs_t is /proc/<pid>/ns/*: `systemctl` stats /proc/1/ns/pid to work out
# whether it is inside a container before it talks to the manager, so every
# login session does it on its first systemctl. Against `unpriv_userdomain`
# rather than user_t after the same measurement as rule 11: the operator moved
# from user_t to staff_t with the administrative role and the denial came
# straight back. getattr on a namespace link, nothing else.
allow unpriv_userdomain nsfs_t:file getattr;
# The socket FILES the activation above puts in /run/user/<uid>/gnupg. The
# directory was rule 11; these are the entries in it.
allow systemd_user_session_type gpg_runtime_t:sock_file { create getattr write unlink };

########################################################################
# 15. dbus asks the system manager whether it is still running.
#
#   comm="dbus-broker-lau" tclass=system status
#     scontext=system_dbusd_t tcontext=init_t
#
# `system status` is systemd's own permission class for "may this domain query
# the manager". dbus-broker-launch reads the manager state at startup. A query,
# with no ability to start, stop or reload anything -- those are separate
# permissions in the same class and are not granted here.
########################################################################
allow system_dbusd_t init_t:system status;

########################################################################
# 16. An administrative command has to be able to answer the session that ran it.
#
#   comm="sesh"       tclass=fifo_file { write } scontext=...:sysadm_t
#                                                tcontext=...:sshd_t
#   comm="sesh"       tclass=fifo_file { write } scontext=...:sysadm_t
#                                                tcontext=...:staff_t
#   comm="docker"     tclass=file { write } scontext=...:dockerc_t
#                                           tcontext=...:user_tmp_t
#   comm="semodule"   tclass=file { write } scontext=...:semanage_t   ...
#   comm="load_policy" tclass=file { write } scontext=...:load_policy_t ...
#
# One mechanism, found five times, and the most consequential thing in this
# whole module because of how it fails.
#
# `sudo` with a role change execs the command through `sesh` after setexeccon,
# so the command runs in a domain of its own -- sysadm_t, or something sysadm_t
# transitions into further (dockerc_t for the docker client, semanage_t and
# load_policy_t for `semodule -B`, setfiles_t for restorecon). Its stdout and
# stderr are whatever the SESSION opened: on a NON-interactive
# `ssh host sudo ...` -- which is what every script and this profile's own
# acceptance run does -- that is a pipe belonging to sshd_t or to the login
# shell, or a file the shell created in /tmp or under $HOME. refpolicy grants
# the sshd pipe to `unpriv_userdomain`, and none of these domains is in that
# attribute.
#
# The symptom is worse than a denial in a log: the command RUNS, exits 0, and
# its output silently disappears. Measured exactly that way -- `sudo id -Z`
# printed nothing while `sudo sh -c 'id -Z >/tmp/z'` wrote the right answer,
# `ufw status | head` reported a working firewall as empty, and
# `docker run hello-world` returned success with no greeting.
#
# An INTERACTIVE session sees none of it: `ssh -t` gives sudo a terminal, and
# sudo relabels a terminal for the target context, which refpolicy already
# allows. This is entirely about automation.
#
# refpolicy has a boolean that would fix the sshd_t half, `ssh_sysadm_login`:
# it swaps that rule from `unpriv_userdomain` to `userdomain`. It is NOT used
# here, because it grants a second thing this profile does not want --
# `allow sshd_t userdomain:process transition`, i.e. sshd may put a login
# DIRECTLY into sysadm_t. The whole point of mapping the operator to staff_u
# rather than sysadm_u is that the login session stays confined and only sudo
# is not; a boolean that re-opens direct sysadm login is the opposite of that,
# and it would fix one destination out of three anyway.
#
# ONE DEVIATION from this module's own rule that every line comes from a
# measured denial, stated rather than hidden: the destinations are written as a
# set -- the sshd pipe, the invoking user domain's pipe, and a file in /tmp or
# under $HOME -- and not every domain was measured against every destination.
# Five of the fifteen combinations were. The mechanism is the same one in all
# fifteen, the lab redirects to /tmp while a real operator redirects into their
# home, and discovering the remaining ten one reboot at a time would produce
# the same rules with more rounds. Writing to a descriptor the caller opened
# and handed over is not a reach into anything the caller did not already have.
########################################################################
allow { sysadm_t dockerc_t semanage_t load_policy_t setfiles_t } { user_tmp_t user_home_t }:file { append getattr ioctl lock open read write };
allow { sysadm_t dockerc_t semanage_t load_policy_t setfiles_t } { sshd_t unpriv_userdomain }:fifo_file { append getattr ioctl lock read write };

########################################################################
# 17. sudo asks for CAP_NET_ADMIN on every invocation, and does not need it.
#
#   comm="sudo" capability=12 tclass=capability { net_admin }
#     scontext=tcontext=staff_u:staff_r:staff_sudo_t
#
# Two of these per `sudo`, in sudo itself, before it execs anything -- a plain
# `sudo true` produces them. Measured in enforcing: sudo authenticates, changes
# role, runs the command and exits 0 with the capability refused, so nothing
# depends on it.
#
# dontaudit rather than allow, which is the difference between silencing a
# denial and granting a privilege. CAP_NET_ADMIN in the domain that every
# administrative command passes through is not something to hand over to stop a
# log line, and the acceptance run's "zero denials in enforcing" bar is only
# meaningful if the way it is reached is not "allow everything that appeared".
dontaudit staff_sudo_t self:capability net_admin;

########################################################################
# 18. What the administrative domain needs to run this profile's own update.
#
#   comm="gpg" tclass=unix_stream_socket { read write }
#     scontext=...:gpg_t tcontext=staff_u:sysadm_r:sysadm_t
#   comm="systemd-inhibit" path="/run/systemd/inhibit/1.ref" tclass=fd { use }
#     scontext=...:sysadm_t tcontext=system_u:system_r:systemd_logind_t
#   comm="omarchy-update-" name="63" tclass=filesystem { associate }
#     scontext=staff_u:object_r:sysadm_t tcontext=system_u:object_r:proc_t
#
# Three separate mechanisms, all of them "the administrative domain inherits or
# is handed something", and none of them a new reach:
#
#   * pacman talks to gpg over a socketpair it created itself, and hands gpg
#     one end. refpolicy has this rule for the domains that normally run gpg
#     and not for sysadm_t, which nothing normally ran pacman as. The socket
#     belongs to the process that opened it.
#   * `omarchy-update` takes a systemd-inhibit lock so nothing shuts the
#     machine down mid-transaction; logind hands back a file descriptor and the
#     caller has to keep it open. `fd use` on a descriptor logind chose to give
#     away is the whole of it.
#   * the kernel labels the inodes under /proc/<pid> with the process's own
#     context, so a sysadm_t process reading its own /proc/self/fd/63 -- which
#     is what a bash process substitution is -- makes the policy ask whether a
#     file of type sysadm_t may exist on a proc_t filesystem. It is the
#     process's own /proc entry; the answer is yes.
########################################################################
allow gpg_t sysadm_t:unix_stream_socket { read write ioctl };
allow sysadm_t systemd_logind_t:fd use;
allow sysadm_t proc_t:filesystem associate;

########################################################################
# 19. The same, for the update running unattended under systemd.
#
#   comm="systemd-notify" tclass=unix_stream_socket { read write }
#     scontext=system_u:system_r:systemd_notify_t tcontext=...:initrc_t
#   comm="restorecon"     tclass=unix_stream_socket { read write }
#     scontext=system_u:system_r:setfiles_t        tcontext=...:initrc_t
#
# `systemctl start omarchy-server-update.service` is the path the daily timer
# takes, and it is a different measurement from running the same command by
# hand: under the unit, pacman runs as initrc_t and its stdout is the socket
# systemd connected to the journal. Its children -- systemd-notify from a
# package's post_install, restorecon from selinux-alpm-hook -- transition into
# domains of their own and then cannot write to the socket they inherited, so
# their output disappears from the journal.
#
# Read and write on a stream socket that init handed them, and nothing else.
# The alternative is a service whose log is silently incomplete, which is worse
# than a denial: nobody reads a log to notice what is missing from it.
########################################################################
allow systemd_notify_t initrc_t:unix_stream_socket { read write };
allow setfiles_t initrc_t:unix_stream_socket { read write };
# And restorecon statting the filesystem it is about to walk. /boot is the ESP,
# a vfat filesystem with no xattrs, so restorecon asks what it is before
# deciding it has nothing to do there -- which is precisely the check that
# stops it from trying. dosfs_t is the ESP and nothing else on this profile.
# Raised from both roles, because both the alpm hook (system_r) and a hand-run
# `omarchy-server-selinux relabel` (sysadm_r) walk the same tree.
allow setfiles_t dosfs_t:filesystem getattr;

########################################################################
# 20. The docker CLI, when the `docker` addon is installed.
#
#   comm="docker" path="/tmp/addon-docker.log" tclass=file { write }
#     scontext=...:dockerc_t tcontext=...:user_tmp_t
#   comm="docker" name="/" tclass=dir  { search }     tcontext=cgroup_t
#   comm="docker" name="hpage_pmd_size" tclass=file { read } tcontext=sysfs_t
#   comm="docker" name="/" tclass=filesystem { getattr } tcontext=proc_t
#
# `sudo docker run …` transitions to dockerc_t, refpolicy's domain for the
# docker CLIENT (the daemon is a different one, and is not touched here). Four
# gaps, measured with `docker run hello-world`:
#
#   * the client could not write to the file or pipe its caller gave it, so the
#     container ran, exited 0, and printed nothing. That half is rule 16's
#     block, which dockerc_t shares with every other domain sudo reaches.
#   * cgroup and sysfs reads: the client reports the host's cgroup driver and
#     transparent-hugepage size in `docker info` and checks them before a run.
#   * `proc_t:filesystem getattr` is a statfs of /proc.
#
# All four are reads of host configuration plus writing to a descriptor the
# caller opened. None of them is about what a CONTAINER may do: container
# processes run in container_t, which this module does not mention.
#
# This block is only reachable on a machine that installed the `docker` addon.
# It costs nothing on one that did not -- dockerc_t simply never runs.
########################################################################
allow dockerc_t cgroup_t:dir { search getattr open read };
allow dockerc_t cgroup_t:file { getattr open read };
allow dockerc_t sysfs_t:file { getattr open read };
allow dockerc_t proc_t:filesystem getattr;
# Traversal to reach the descriptors and paths its caller handed it: /tmp
# itself, the caller's own directory under it, and /bin -- which on Arch is a
# symlink to usr/bin that anything resolving a path has to read.
allow dockerc_t { tmp_t user_tmp_t }:dir { search getattr open read };
allow dockerc_t bin_t:lnk_file { read getattr };

########################################################################
# 21. networkd asks for CAP_SYS_ADMIN it does not need.
#
#   comm="systemd-network" capability=21 tclass=capability { sys_admin }
#     scontext=tcontext=system_u:system_r:systemd_networkd_t
#
# Seven per boot, and only on a machine that has the `docker` addon -- the
# bridge docker adds is what makes networkd reconfigure. The kernel's
# bpf_capable() tries CAP_SYS_ADMIN before falling back to CAP_BPF, which rule
# 10 already grants, so the first check is audited and the second one succeeds.
# Measured on the machine that produced these: `networkctl` reports routable
# and online, both interfaces configured, with the denial standing.
#
# dontaudit, not allow, for the same reason as rule 17: CAP_SYS_ADMIN is most
# of root, and handing it to the network manager to silence a log line that a
# working network is already contradicting would be the wrong trade.
########################################################################
dontaudit systemd_networkd_t self:capability sys_admin;

########################################################################
# 22. Rebuilding the policy store from an administrative session.
#
#   comm="semodule" name="file_contexts.homedirs" tclass=file
#     { relabelfrom relabelto } scontext=...:semanage_t
#     tcontext=staff_u:object_r:file_context_t
#   comm="semodule" name="/" tclass=filesystem { getattr }
#     tcontext=... tmpfs_t | devpts_t | cgroup_t | pstore_t | device_t | fs_t
#   comm="semodule" path="/tmp/..." tclass=file { write } tcontext=user_tmp_t
#
# `omarchy-server-selinux admin-role` runs `semodule -B` on the machine, and on
# an already-enforcing machine that is the first time semanage_t has ever run
# here -- the install-time path runs it in a chroot where SELinux is not
# active, so none of this was reachable before.
#
# Two of the three are straightforward:
#
#   * a statfs of every mounted filesystem: genhomedircon walks the mount table
#     to decide which home directories are real. Against the `filesystem_type`
#     ATTRIBUTE, because the set is "whatever this machine has mounted" -- the
#     first measurement produced six types and a machine with an NFS mount or a
#     USB stick would produce more. getattr on a filesystem returns its size
#     and free space.
#   * writing to the caller's redirect is rule 16's block, and semanage_t and
#     load_policy_t are both in it.
#
# The relabelling is DONTAUDITED, not allowed, and that is the interesting one.
# libsemanage tries to set the context on each file it regenerates in the
# store. It may not, for two independent reasons, and refpolicy means both:
#
#   * `relabelto policy_config_t` is a NEVERALLOW in refpolicy's own
#     selinuxutil module. A rule granting it does not merely widen the policy,
#     it refuses to compile -- which is refpolicy stating, in the strongest
#     form it has, that the store manager must not mint policy-file labels.
#   * the rest fail the identity constraint. `constrain file relabelto
#     (u1 == u2 or t1 == can_change_object_identity)`: the process is
#     staff_u (the administrator's SELinux user, through sudo) and the target
#     context it wants is system_u, and semanage_t is deliberately not in
#     can_change_object_identity. Adding it there would let the store manager
#     label a file as any SELinux user -- a much larger grant than the thing
#     being fixed.
#
# Nothing breaks. The files keep the context the type transition gave them --
# the right TYPE, under the administrator's identity instead of system_u --
# `semodule -B` commits and exits 0, and refpolicy-arch has UBAC off so the
# user field of a file context gates nothing. `admin-role` then runs
# `restorecon -F` over the store, which is setfiles_t's job and which setfiles_t
# is allowed to do, so the identity on disk is correct afterwards and the label
# drift check stays clean. Measured: 0 drift under /var/lib/selinux and
# /etc/selinux after an admin-role run on an enforcing machine.
########################################################################
allow semanage_t filesystem_type:filesystem getattr;
dontaudit semanage_t { file_context_t policy_config_t selinux_config_t semanage_store_t }:file { relabelfrom relabelto };
dontaudit semanage_t semanage_store_t:dir { relabelfrom relabelto };

########################################################################
# 23. systemd-sysusers, when pacman is run by an administrator rather than by
#     the update timer.
#
#   comm="systemd-sysuser" name=".#gshadow…" tclass=file
#     { create write setattr rename unlink }
#     scontext=staff_u:sysadm_r:sysadm_t tcontext=system_u:object_r:shadow_t
#   comm="systemd-sysuser" capability=29 { audit_write }
#
# The `docker` addon installs a package that ships a sysusers.d fragment, and
# an alpm hook runs `systemd-sysusers` to create the `docker` group. Under the
# daily update timer that happens inside a pacman running as initrc_t, which
# refpolicy DOES transition into systemd_sysusers_t -- a domain that already
# has every rule this needs, including the shadow files and the audit record.
# Run by hand through sudo, pacman is sysadm_t, refpolicy has no transition
# from there, and systemd-sysusers ends up editing /etc/gshadow AS the
# administrative domain.
#
# The fix is to make the transition happen, not to give sysadm_t the shadow
# files. Those two are not close: shadow_t is an `auth_file_type`, which is
# exactly the set refpolicy withholds from sysadm_t on purpose so that password
# and group databases are only ever written by the account tools. Adding
# `allow sysadm_t shadow_t:file write` would be two lines and would quietly
# retire that separation for every command an administrator ever runs. Four
# lines and a role association reuse the domain refpolicy already wrote.
#
# `role sysadm_r types systemd_sysusers_t` is what makes the new domain
# reachable from the administrator's role at all; without it the transition is
# an invalid context rather than a denial.
########################################################################
role sysadm_r types systemd_sysusers_t;
type_transition sysadm_t systemd_sysusers_exec_t:process systemd_sysusers_t;
allow sysadm_t systemd_sysusers_t:process transition;
allow sysadm_t systemd_sysusers_exec_t:file { getattr open read execute map };
allow systemd_sysusers_t systemd_sysusers_exec_t:file entrypoint;
# The three permissions every domain transition needs beside `transition`
# itself: the child inherits the parent's signal disposition and rlimits, and
# noatsecure says the dynamic linker need not run in secure mode across it.
# refpolicy grants all three on the init_t -> systemd_sysusers_t transition it
# already has; this is the same set for the new source domain.
allow sysadm_t systemd_sysusers_t:process { siginh rlimitinh noatsecure };
# And what systemd-sysusers does once it is there. refpolicy's rules for this
# domain were written for the transition from init_t and cover the account
# files; the audit record it writes when it creates a group was measured
# missing on BOTH paths -- rule 13 already had to add `create` on the socket
# from the timer path, and running it from sudo turned up the rest of the same
# operation. Refusing an audit record is the wrong direction: the whole point
# of the record is that somebody added a group.
allow systemd_sysusers_t self:netlink_audit_socket { read write nlmsg_relay };
allow systemd_sysusers_t self:capability audit_write;

########################################################################
# 24. depmod, on the build root mkinitcpio creates in /tmp — the §11.5 open
#     question, closed.
#
#   comm="depmod" name="mkinitcpio.tQq4WU" tclass=dir { search }
#     scontext=staff_u:sysadm_r:kmod_t tcontext=staff_u:object_r:user_tmp_t
#
# mkinitcpio assembles the image in a `mktemp -d` under /tmp and then runs
# `depmod -b <buildroot>` over it. depmod execs kmod, which type-transitions
# into kmod_t; the build root was created by the administrator's shell, so it
# is user_tmp_t; and kmod_t has no rule to so much as SEARCH a user_tmp_t
# directory. depmod therefore cannot enter the tree it was pointed at, exits
# non-zero, mkinitcpio raises "errors were encountered during the build", and
# limine-entry-tool follows with "mkinitcpio failed for kernel …, skipping"
# and does not write the UKI.
#
# That is the failure reports/2026-08-29-mandatory-access-control.md §11.5
# recorded and could not explain, and the reason it looked like it had no
# denial behind it is worth writing down: the run looked with `ausearch`, and
# `ausearch` reads auditd's log. This profile does not install auditd. The
# records were in the kernel ring buffer the whole time — `journalctl -k -g
# 'avc: *denied'` had them — and they are exactly three lines.
#
# It is the same shape as rule 23: **an administrative path that the update
# timer never takes.** Under the timer, pacman is initrc_t, its temporary
# directories are initrc_tmp_t, and refpolicy's kmod_t works there. Run by hand
# through sudo -- `sudo pacman -S linux`, `omarchy-server-selinux disable`,
# `limine-update` -- pacman is sysadm_t and the same build root lands in the
# administrator's tmp instead. So a machine whose kernel is updated by the
# timer never sees it, and a machine whose operator updates it by hand cannot
# rebuild its own boot image. That asymmetry is why it survived §10 and §11.
#
# This is the second rule in this module written wider than the object it was
# measured on, and, like rule 16, it says so. The alternative -- labelling the
# build root, which is what this module prefers -- has no mechanism here: the
# directory is `mkinitcpio.XXXXXX` from mktemp, and a name-based type
# transition matches an exact name, not a prefix. What limits the widening is
# the subject rather than the object: kmod_t is entered only by exec'ing
# depmod/modprobe/modinfo, only from a domain that already had them, and the
# files it reaches here are files that same administrator created and can read
# directly. Nothing confined gains anything.
########################################################################
allow kmod_t user_tmp_t:dir { search getattr read open write add_name remove_name };
allow kmod_t user_tmp_t:file { getattr read open map create write rename unlink };
allow kmod_t user_tmp_t:lnk_file { getattr read };

########################################################################
# 25. modinfo, and a lock file it never asked for.
#
#   comm="modinfo" path="/run/lock/boot-partition.lock" tclass=file { write }
#     scontext=staff_u:sysadm_r:kmod_t
#     tcontext=staff_u:object_r:httpd_lock_t   (and initrc_lock_t)
#
# limine's mutex_lock() does `exec 200>/run/lock/boot-partition.lock` and holds
# that descriptor open for the whole of the rebuild. Every process the rebuild
# starts inherits it, modinfo included -- and modinfo type-transitions into
# kmod_t, at which point the kernel revalidates the inherited descriptors
# against the new domain, refuses the write it was opened with, closes the
# descriptor in the child and logs this.
#
# Nothing is broken by that. modinfo does not touch fd 200; the lock belongs to
# the shell that opened it, and that shell keeps it. So this is a denial for
# something that is genuinely not needed, which is what `dontaudit` is for --
# the same treatment rules 17 and 21 give the two capabilities sudo and
# networkd ask for and do not miss. Allowing kmod_t to write lock files to make
# the line go away would grant a real permission to silence a non-event.
#
# Two types because the lock file's label depends on who created it first: the
# update timer's pacman is initrc_t and leaves initrc_lock_t, an administrator's
# shell leaves httpd_lock_t, which is refpolicy's generic for a file created in
# /run/lock with no transition of its own. Both were measured.
########################################################################
dontaudit kmod_t { httpd_lock_t initrc_lock_t }:file write;

########################################################################
# 26. cloud-init, which an installed machine never runs.
#
#   comm="python3" name="local.sock" tclass=sock_file { create }
#     scontext=system_u:system_r:cloud_init_t
#     tcontext=system_u:object_r:cloud_init_runtime_t
#   comm="python3" path="/run/cloud-init/share/final.sock" { getattr }
#   comm="python3" tclass=process { getsched } (itself)
#   comm="python3" path="/proc/sys/vm/overcommit_memory" { read open }
#     tcontext=system_u:object_r:sysctl_vm_overcommit_t
#   comm="systemd-detect-" path="pid:[…]" tclass=file { getattr }
#     tcontext=system_u:object_r:nsfs_t
#
# refpolicy has a cloud-init module and it is a good one -- cloud_init_t exists,
# the growpart path works with no rule from here, and every home directory,
# authorized_keys file and hostname this image's first boot writes is already
# allowed. What it does not have is cloud-init 25's own runtime directory: the
# agent now opens unix sockets under /run/cloud-init/share (`local.sock`,
# `final.sock`) to hand its stage results to `cloud-init status`, and the type
# transition puts them in cloud_init_runtime_t while the policy's rules for
# that type stop at plain files.
#
# The other three are the same shape as rules 2, 3 and 14 -- a modern userland
# asking the kernel about itself. `getsched` on its own process is cloud-init's
# multiprocessing pool; /proc/sys/vm/overcommit_memory is what python's
# resource-tracker reads before forking; nsfs is systemd-detect-virt looking at
# PID 1's namespace to answer "am I in a container".
#
# All five are inside cloud_init_t's own boundary: its runtime directory, its
# own process, and two read-only files about the kernel. Nothing here lets the
# agent reach further into the machine than the policy already lets it.
########################################################################
allow cloud_init_t cloud_init_runtime_t:sock_file { create getattr write unlink };
allow cloud_init_t self:process getsched;
allow cloud_init_t sysctl_vm_t:dir search;
allow cloud_init_t sysctl_vm_overcommit_t:file { getattr read open };
allow cloud_init_t nsfs_t:file getattr;

########################################################################
# 27. `cloud-init status`, run by the operator rather than by the boot.
#
#   comm="python3" path="/var/lib/cloud/data/status.json" tclass=file { read open }
#     scontext=staff_u:staff_r:staff_t tcontext=system_u:object_r:cloud_init_state_t
#   comm="python3" name="status.json" tclass=lnk_file { read }
#     tcontext=system_u:object_r:cloud_init_runtime_t
#   comm="python3" name="cloud.cfg" tclass=file { read open }
#   comm="python3" saddr=::1 tclass=tcp_socket { node_bind }
#
# On a cloud machine `cloud-init status --wait` is the first thing anyone types,
# and on this profile the operator's session is staff_t. refpolicy's cloud-init
# module grants the agent's own domain and the administrative role; a confined
# login session has no rule for either the state directory or the runtime one,
# so the command reports `error` on a machine whose provisioning was perfect.
#
# READ-ONLY, and to staff_t alone rather than to the unpriv_userdomain
# attribute. status.json is a status file whose DAC mode is already 0644 --
# withholding it from the administrator's own login domain protects nothing --
# but user_t, the domain an ordinary account gets on this profile, has no
# business in the provisioning record and keeps none.
#
# The node_bind is DONTAUDITED rather than allowed, and the reason is the
# discipline of rules 17 and 21: cloud-init's status client asks for a loopback
# TCP bind while probing which address families it has, and measured with the
# permission refused it prints the same status. A rule letting a confined user
# domain bind sockets to the generic node type, to silence a probe that already
# copes with the answer, would be a real grant for a non-event.
########################################################################
allow staff_t cloud_init_state_t:dir { search getattr open read };
allow staff_t cloud_init_state_t:file { getattr read open };
allow staff_t cloud_init_state_t:lnk_file { getattr read };
allow staff_t cloud_init_runtime_t:dir { search getattr open read };
allow staff_t cloud_init_runtime_t:file { getattr read open };
allow staff_t cloud_init_runtime_t:lnk_file { getattr read };
dontaudit { staff_t sysadm_t } node_t:tcp_socket node_bind;

########################################################################
# 28. `systemctl status` and `systemctl --failed`, from that same session.
#
#   cmdline="systemctl --failed --no-pager" function="list_units_filtered"
#     tclass=service { status } scontext=staff_u:staff_r:staff_t
#     tcontext=system_u:object_r:{ syslogd_unit_t systemd_networkd_unit_t
#                                  auditd_unit_t power_unit_t … init_runtime_t }
#
# systemd checks `service { status }` per unit and, when it is refused, LEAVES
# THE UNIT OUT of the listing. There is no error: `systemctl --failed` on a
# machine with a failed unit prints an empty table, and the operator -- and this
# repository's own acceptance list, which asks exactly that question -- reads it
# as a healthy machine. A check that cannot fail is worse than no check.
#
# Against the `systemdunit` attribute, not the seven unit types the first run
# produced. That is the §10.2 lesson for the third time: the set is "every unit
# on the machine", and enumerating it means a new denial for every package that
# ships a unit. init_runtime_t is named beside it because a generator's output
# under /run/systemd/generator (the zram swap unit, here) is not in that
# attribute and is still a unit somebody asks about.
#
# staff_t only, again. `status` is read-only -- it does not start, stop or
# enable anything, and every one of those verbs stays where refpolicy put it.
########################################################################
allow staff_t systemdunit:service status;
allow staff_t init_runtime_t:service status;

########################################################################
# 29. systemd-tmpfiles provisioning /root/.ssh from a credential.
#
#   comm="systemd-tmpfile" name="root" tclass=dir { write }
#     tcontext=root:object_r:user_home_dir_t
#   comm="systemd-tmpfile" name=".ssh" tclass=dir { add_name create }
#     tcontext=root:object_r:ssh_home_t
#
# systemd 261 ships /usr/lib/tmpfiles.d/provision.conf, which creates
# /root/.ssh and writes /root/.ssh/authorized_keys from the
# `ssh.authorized_keys.root` system credential. That is a first-boot path by
# construction -- the directory exists ever after -- so an installed machine
# saw it once, long before anyone measured, and a machine from an image runs it
# on the boot this suite watches.
#
# It is also a path worth keeping working rather than silencing: a platform
# that hands the machine a root key through a credential (systemd's own
# smbios/qemu fw_cfg route, which is how several hypervisors do it) has no
# other way in. systemd_tmpfiles_t is the domain refpolicy trusts to create
# exactly this kind of thing everywhere else on the filesystem; the two types
# here are only unusual because this profile's /root is user_home_dir_t.
########################################################################
allow systemd_tmpfiles_t user_home_dir_t:dir { search getattr write add_name };
allow systemd_tmpfiles_t ssh_home_t:dir { create getattr setattr search };

########################################################################
# 30. depmod again, on the build root of an initramfs rebuilt by a SERVICE.
#
#   comm="depmod" name="mkinitcpio.nP7j5H" tclass=dir { search }
#     scontext=system_u:system_r:kmod_t
#     tcontext=system_u:object_r:initrc_tmp_t
#
# Rule 24 closed this for the administrative path (`sudo pacman -S linux`,
# where the build root is user_tmp_t) and its comment says the update timer is
# safe because pacman under systemd is initrc_t and "refpolicy's kmod_t works
# there". Measured on the first boot of a cloud image, that is not true: the
# build root is initrc_tmp_t and kmod_t cannot search it either. The same
# three-line failure follows -- depmod exits non-zero, mkinitcpio reports
# "errors were encountered during the build", limine-entry-tool skips the UKI.
#
# The image is what found it because omarchy-server-firstboot.service runs
# `limine-update` on the first boot to re-tag the boot entry with this
# machine's machine-id (docs/cloud-image.md §5.1), and a service's temporary
# directory is initrc_tmp_t. But the domain is the same one the daily update
# timer runs a kernel upgrade in, so this is not an image-only fix: it is rule
# 24's other half, and without it a machine that takes a kernel update from its
# own timer cannot rebuild its own boot image either.
#
# The permission set is rule 24's, including `write` on the directory, and that
# half was measured separately: with only the read side granted, depmod enters
# the tree and is then refused when it writes modules.dep and its four
# companions back into it -- ten denials on one rebuild, the same non-zero exit,
# the same skipped UKI. depmod's whole job is to write those files.
#
# Same limit on the widening as rule 24: kmod_t is entered only by exec'ing
# depmod/modprobe/modinfo from a domain that already had them, and initrc_tmp_t
# here is a directory that same system service created moments earlier.
########################################################################
allow kmod_t initrc_tmp_t:dir { search getattr read open write add_name remove_name };
allow kmod_t initrc_tmp_t:file { getattr read open map create write rename unlink };
allow kmod_t initrc_tmp_t:lnk_file { getattr read };

########################################################################
# 31. Two more inherited descriptors, from the same first boot.
#
#   comm="loadkeys" path="/run/lock/boot-partition.lock" tclass=file { write }
#     scontext=system_u:system_r:loadkeys_t tcontext=…:initrc_lock_t
#   comm="btrfs" path="pipe:[…]" tclass=fifo_file { write getattr }
#     scontext=staff_u:sysadm_r:fsadm_t tcontext=staff_u:staff_r:staff_t
#
# The first is rule 25 with a different child: limine's `mutex_lock()` holds
# /run/lock/boot-partition.lock open across the whole rebuild, and every process
# it starts inherits the descriptor -- loadkeys, from the initramfs hook that
# adds the keymap, as well as modinfo. Nothing touches fd 200, so dontaudit,
# for the same reason rule 25 gives.
#
# The second is rule 16, whose subject list this adds to rather than repeats.
# `sudo btrfs subvolume list /` over a non-interactive ssh is how this
# repository's own acceptance asks whether @factory is present; btrfs
# type-transitions into fsadm_t, its stdout is the login session's pipe, and
# with the write refused the command exits 0 and prints nothing. A check that
# reads "no @factory" on a machine that has one is exactly the failure rule 16
# exists to prevent, and fsadm_t is reached the same way every other domain in
# that list is: by an administrator running one command through sudo.
########################################################################
dontaudit loadkeys_t initrc_lock_t:file write;
allow fsadm_t { user_tmp_t user_home_t }:file { append getattr ioctl lock open read write };
allow fsadm_t { sshd_t unpriv_userdomain }:fifo_file { append getattr ioctl lock read write };

########################################################################
# 32. mount, reading udev's record of the device it is about to mount.
#
#   comm="mount" name="b11:0" tclass=file { read }
#     scontext=system_u:system_r:mount_t
#     tcontext=system_u:object_r:udev_runtime_t
#
# Five times on every boot of a machine with a NoCloud seed: cloud-init mounts
# /dev/sr0 to read its metadata, and libblkid asks /run/udev/data/b11:0 what
# that device already is instead of probing it again. udev writes those files
# for exactly this purpose -- they are the device database, they hold no
# content of the device, and every other filesystem tool on the machine reads
# them.
#
# It is allowed rather than dontaudited, which is the opposite of the choice
# rules 25 and 31 make about inherited descriptors, and the difference is worth
# stating: with the read refused libblkid falls back to probing, so nothing
# breaks today -- but the fallback is what runs, and a probe of a device
# somebody else's metadata drive points at is more work with less authority
# behind it than the record udev already made.
########################################################################
allow mount_t udev_runtime_t:dir search;
allow mount_t udev_runtime_t:file { getattr read open };

########################################################################
# 33. cloud-init rotating the ssh host keys of a RE-PROVISIONED machine.
#
#   comm="python3" name="ssh_host_rsa_key" tclass=file { unlink }
#     scontext=system_u:system_r:cloud_init_t
#     tcontext=system_u:object_r:sshd_key_t
#
# Not on the first boot of an image -- there, omarchy-server-firstboot has
# already made the keys by the time cc_ssh looks, and cc_ssh leaves them alone;
# measured, no denial. This is the other case: a machine whose metadata gives
# it a NEW instance-id on a disk that already has host keys. That is a clone
# taken from a running machine rather than from a generalized image, and it is
# the one shape of copy this profile's own first-boot path does not cover,
# because there was no generalization to delete the keys.
#
# cc_ssh's job there is precisely to delete them and generate a fresh set
# (`ssh_deletekeys`, on by default), and a refusal is the bad kind of quiet:
# cloud-init logs a recoverable error, the boot finishes, and the clone answers
# ssh with its parent's host key -- the exact failure the whole generalization
# list exists to prevent, arriving through the one door it does not watch.
#
# Found by running `cloud-init clean` and rebooting, which is how a
# re-provision is simulated, and kept because the scenario is real even though
# the pipeline's own path does not take it. Read and unlink only: the keys
# themselves are written by ssh-keygen, which refpolicy already transitions
# into ssh_keygen_t.
########################################################################
allow cloud_init_t sshd_key_t:file { getattr read unlink };

########################################################################
# 34. THE RULE THAT IS NOT HERE: cloud-init's locale module.
#
#   comm="localedef" name="UTF-8.gz" tclass=file { read map ioctl }
#     scontext=system_u:system_r:cloud_init_t tcontext=…:usr_t
#   comm="rm" name="locale" tclass=dir { write } tcontext=…:locale_t
#   comm="localedef" name="locale-archive.Sy75sF" { link setattr }
#   comm="systemd-localed" name="locale-gen" tclass=file { execute }
#     scontext=system_u:system_r:systemd_locale_t tcontext=…:bin_t
#
# `cc_locale` rewrites /etc/locale.gen and runs `locale-gen`, which on Arch
# deletes the locale archive and rebuilds it with localedef; then `localectl
# set-locale`, and systemd-localed on Arch shells out to locale-gen in turn.
# Granting all of that costs cloud_init_t a general read of /usr, write access
# to /usr/lib/locale, and systemd_locale_t the right to EXECUTE binaries out of
# /usr/bin. Three real widenings, for work this profile has already done: the
# locale is set at install time and the module was measured setting it to the
# value it already had.
#
# So the fix is one line of configuration instead, in
# install/server/cloud-server.sh: `locale: false`, which cc_locale documents as
# "skip me". It is the same trade the same file already makes for networking --
# the profile owns it, cloud-init does not write it, and the cost is that a
# platform handing out a locale through its metadata is not honoured.
#
# Written down as a rule that is deliberately absent, in the same spirit as the
# lastlog note in this file's header: the next person to see these denials
# should find the decision, not repeat the measurement.
########################################################################

########################################################################
# 35. useradd copying /etc/skel into a home directory cloud-init asked for.
#
#   comm="useradd" name=".config" tclass=dir { read }
#     scontext=system_u:system_r:useradd_t
#     tcontext=user_u:object_r:xdg_config_t
#   comm="useradd" name="git" tclass=dir { read } tcontext=…:git_xdg_config_t
#   comm="useradd" capability=2 { dac_read_search }
#
# This profile's /etc/skel is not empty: it carries .config/btop,
# .config/git and .local, which the settings package installs. libselinux
# labels those by their home-directory pattern rather than by /etc, so the
# skeleton is xdg_config_t and friends -- and refpolicy's useradd_t has rules
# for the home directory it CREATES, not for reading a skeleton labelled as
# somebody's configuration.
#
# On an installed machine the orchestrator creates the account, in a phase
# where the machine is not yet enforcing anything. On an image, cloud-init
# creates every account on the first boot, so this is the boot that finds it:
# with the reads refused, the account is created and its home comes out missing
# the parts of the skeleton the policy would not let useradd read -- silently,
# because useradd does not fail on a skeleton entry it cannot copy.
#
# The capability goes with it: useradd is root and still asks for
# CAP_DAC_READ_SEARCH to walk a tree whose modes it does not own. It is granted
# rather than dontaudited because the same walk is the copy, and half a
# skeleton is the failure this rule exists to prevent.
########################################################################
allow useradd_t { xdg_config_t xdg_data_t git_xdg_config_t }:dir { search read open getattr };
allow useradd_t { xdg_config_t xdg_data_t git_xdg_config_t }:file { getattr read open };
allow useradd_t self:capability dac_read_search;

########################################################################
# 36. `systemctl is-enabled` from the operator's session.
#
#   comm="systemctl" path="/usr/lib/systemd/system-preset/90-systemd.preset"
#     tclass=file { read open ioctl } scontext=staff_u:staff_r:staff_t
#     tcontext=system_u:object_r:systemd_unit_t
#
# Rule 28's other half. `systemctl is-enabled <unit>` reads the preset files to
# answer for a unit with no explicit symlink, and the preset directory is
# systemd_unit_t like the unit files themselves. Read-only, on files that
# describe which units a distribution enables by default; every one of them is
# world-readable on disk.
########################################################################
allow staff_t systemd_unit_t:file { getattr read open ioctl };
allow staff_t systemd_unit_t:dir { search getattr open read };

########################################################################
# 37. The per-user manager, and the guest agent's channel device.
#
#   comm="systemd" path="/dev/vport2p1" tclass=chr_file { getattr }
#     scontext=staff_u:staff_r:staff_systemd_t
#     tcontext=system_u:object_r:virtio_device_t
#
# Only on a machine that has a virtio-serial channel, which is every machine
# this image is meant for: the channel is how qemu-guest-agent answers a
# hypervisor's "stop instance" and its volume freeze/thaw. The per-user systemd
# manager enumerates /dev when it sets up the session's device units and stats
# what it finds. getattr on a character device it will never open.
########################################################################
allow systemd_user_session_type virtio_device_t:chr_file getattr;

########################################################################
# 38. `ss` asking the kernel to load the socket-diagnostics module.
#
#   comm="ss" kmod="net-pf-16-proto-4-type-2" tclass=system { module_request }
#     scontext=staff_u:sysadm_r:sysadm_t tcontext=system_u:system_r:kernel_t
#
# `ss -ltnup` uses the sock_diag netlink family, and on a machine where nothing
# has used it yet the kernel offers to autoload it. Refusing the request does
# not break the command -- ss falls back to /proc/net, which is where it read
# everything before sock_diag existed, and the acceptance list that runs it gets
# the same answer either way. Measured on this run: the listening-socket check
# passed with the denial standing.
#
# So it is dontaudited, for the same reason as rules 17, 21 and 25: allowing a
# user domain to make the kernel load modules is a real grant, and it would be
# made to silence a request the caller already copes with. It is written down
# because of what it did before it was silenced -- it is a `system` class denial
# from the administrative role, which `omarchy-server-selinux enforcing`
# classifies as a login-path lockout risk, so the guard refused to enforce over
# a fallback nobody would have noticed.
########################################################################
dontaudit { staff_t sysadm_t user_t } kernel_t:system module_request;

########################################################################
# 39. `ss`, once the module rule 38 silenced has been loaded anyway.
#
#   comm="ss" tclass=netlink_tcpdiag_socket
#     { create bind read write getattr setopt nlmsg_read }
#     scontext=staff_u:staff_r:staff_t
#
# The sequel to rule 38, and the reason that rule is a dontaudit rather than a
# grant: on a machine where the sock_diag module IS loaded -- by an
# administrator's `sudo ss` a minute earlier, or by anything else that asks --
# `ss` takes the netlink path instead of the /proc fallback, and a confined user
# domain has no rules for that socket class. refpolicy grants it to sysadm_t and
# stops there.
#
# What it costs to refuse is a listening-socket list that is silently EMPTY:
# this repository's own acceptance asks "nothing listens except ssh" with
# `ss -ltnup` from the login session, and an empty answer reads as a pass. The
# same shape as rule 28 -- a query that returns nothing rather than an error --
# and the same conclusion.
#
# Read-only diagnostics on the machine's own sockets, to the administrator's
# login domain. user_t, the domain an ordinary account gets, is not in it.
########################################################################
allow staff_t self:netlink_tcpdiag_socket { create bind read write getattr setopt nlmsg_read };
