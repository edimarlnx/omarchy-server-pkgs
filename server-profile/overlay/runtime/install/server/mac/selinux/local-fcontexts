# File contexts this profile adds to the reference policy.
#
# install/server/selinux-server.sh renders these into the policy store's
# file_contexts.local -- the same file `semanage fcontext -a` would write, in
# the same format, at the path libselinux looks for it. Writing it directly is
# what lets the `selinux` addon leave selinux-python (and setools, and 453 MiB
# of scientific Python) to the separate `selinux-tools` addon.
#
# Format: <path regex> <whitespace> <SELinux type>. Comments and blank lines
# are ignored. The setup leaf adds the user and role, and adds a level only if
# the loaded policy is MLS -- refpolicy-arch is built TYPE=standard and is not,
# so a hand-written `:s0` here would be an INVALID context, silently dropped by
# setfiles with the rule it belongs to. Write the bare type.
#
# A file context is the right tool when the policy already has rules for the
# type and only the path is wrong. Where a rule is genuinely missing, it goes
# in omarchy_server.te beside this file.
#
# /usr/share/omarchy/bin holds programs, not data, and the reference policy's
# default for anything below /usr/share is usr_t. Labelling them bin_t is what
# lets the existing policy treat them as what they are: a root shell executes
# them and systemd execs them from a unit, and both of those are questions the
# policy already has answers for. /usr/share/omarchy/install is the setup tree
# -- sourced, never executed -- and stays data.

/usr/share/omarchy/bin(/.*)?	bin_t

# /var/lib/lastlog holds shadow's lastlog2.db, which sshd writes on every
# login. refpolicy knows lastlog_t and grants sshd_t what it needs on it, but
# only names /var/log/lastlog -- shadow moved the database to /var/lib and the
# policy has not followed. Eight of the eighteen denials on a bare boot were
# this one file.
#
# Labelling the path is the whole fix, and it is the right shape of fix:
# the alternative is a policy rule letting sshd_t write every var_lib_t file on
# the system in order to reach one database.
/var/lib/lastlog(/.*)?	lastlog_t

# /etc/pacman.d/gnupg is pacman's keyring: a GnuPG home directory that happens
# to live under /etc, so the reference policy's default gives it etc_t and gpg
# is refused when it writes there. Measured on every `pacman -Sy`:
#
#   comm="gpg" name="trustdb.gpg" tclass=file { write }
#     scontext=...:gpg_t tcontext=system_u:object_r:etc_t
#
# gpg exits non-zero on that and pacman carries on, which is the worst shape a
# failure can have: the trust database silently stops being updated while every
# transaction still succeeds. Not something to dontaudit.
#
# gpg_secret_t is refpolicy's type for the contents of a GnuPG home, and gpg_t
# already has exactly the file and directory permissions it needs on it. The
# alternative -- a rule letting gpg_t write etc_t -- would give the domain that
# parses untrusted signatures write access to the whole of /etc. Label the
# object, do not widen the subject, again.
#
# It costs nothing on the reading side: gpg_secret_t is non_auth_file_type, so
# sysadm_t (pacman under sudo) and init_t (pacman under the update timer) keep
# the access they had, and the DAC modes on the private key material are what
# they always were.
/etc/pacman\.d/gnupg(/.*)?	gpg_secret_t

# containerd creates /opt/containerd/{bin,lib} for its plugins on first start.
# /opt is usr_t, so the daemon is refused:
#
#   comm="containerd" name="containerd" tclass=dir { add_name }
#     scontext=system_u:system_r:dockerd_t tcontext=system_u:object_r:usr_t
#
# The rule that would fix it in policy is `allow dockerd_t usr_t:dir add_name`,
# which is a container runtime with write access to /opt, /usr/share and
# everything else the default gives usr_t. Labelling the one directory it
# actually owns is the same fix at a fraction of the reach: container_var_lib_t
# is what /var/lib/containerd already carries, and refpolicy grants dockerd_t
# what it needs on it.
#
# Only reachable on a machine that installed the `docker` addon; on any other
# one the path does not exist and the rule matches nothing.
/opt/containerd(/.*)?	container_var_lib_t
