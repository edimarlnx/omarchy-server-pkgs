[Unit]
# One-shot filesystem relabel, gated on /.autorelabel.
#
# The `selinux` addon relabels the filesystem offline, inside the install
# chroot, because a relabel is minutes of I/O and the install is already
# writing. What it cannot label is anything created AFTER it runs -- and the
# orchestrator creates the user's home directory in a later phase. A machine
# installed without this unit comes up with /home/<user> unlabeled, which is
# invisible in permissive and locks the operator out the moment SELinux goes
# enforcing: user_t may not search unlabeled_t, so the session cannot reach its
# own home, and `sudo` is unreachable with it.
#
# That is a measured failure, not a hypothesis:
# reports/2026-08-29-mandatory-access-control.md.
#
# Ordering: before ANY login can happen, and that is the whole point of the
# unit. systemd-user-sessions.service is the gate -- it removes /run/nologin --
# so ordering ahead of it holds back ssh, the serial getty and the virtual
# consoles alike, rather than ahead of sshd only and racing the getty.
#
# The machine boots PERMISSIVE after the addon, so nothing is refused while
# this runs; the relabel just has to have finished before anyone switches to
# enforcing, and the first login is the earliest anyone could. It runs once:
# the flag is removed when it succeeds, so every subsequent boot skips it on
# the condition and adds nothing to the boot path.
Description=Relabel the filesystem for SELinux (one-shot)
Documentation=man:restorecon(8)
ConditionPathExists=/.autorelabel
ConditionSecurity=selinux
DefaultDependencies=yes
After=local-fs.target
# After sshdgenkeys, before sshd. Arch generates the ssh host keys in
# sshdgenkeys.service, which sshd.service Wants and is ordered After -- and on
# a fresh install that is the first boot, i.e. AFTER the offline relabel and,
# without this line, after this unit too. The keys then keep the label of
# /etc, and the private host keys sit there as etc_t instead of sshd_key_t:
# readable by every domain the policy lets read /etc, which is most of them.
# Measured -- eight files, in
# reports/2026-08-29-mandatory-access-control.md.
#
# Slotting in between keygen and sshd costs nothing: sshd already waits for
# sshdgenkeys, so this only lengthens a chain the boot was going to walk.
# Wants as well as After: ordering alone does not pull a unit into the
# transaction, and sshdgenkeys.service is `disabled` on Arch -- it exists only
# because sshd.service wants it. Wanting it here makes the ordering real
# instead of conditional on sshd being in the same transaction. Its own
# ConditionPathExists still skips it when the keys are already there.
Wants=sshdgenkeys.service
After=sshdgenkeys.service
# And after cloud-init, on an image. This is the same argument as the home
# directory above, one step further along: on an INSTALL the orchestrator
# creates /home/<user> in a phase after the offline relabel, and on a machine
# from a shared image EVERY account, home directory and authorized_keys file is
# created by cloud-init, on this boot. cloud-init.service is itself ordered
# Before=systemd-user-sessions.service, so without this line the two are
# unordered and which one runs first is a race.
#
# Measured, the race came out right on its own -- cloud-init created the user
# 3 s before the relabel started, because omarchy-server-firstboot rebuilds the
# initramfs in between -- and useradd labels a home directory correctly anyway.
# Neither of those is a guarantee: the first depends on how long mkinitcpio
# takes, the second on cloud-init using useradd rather than writing the tree
# itself. The ordering costs nothing (both units are in the same part of the
# boot already) and turns an accident into a property.
#
# No Wants=: on a machine without the `cloud` addon cloud-init.service does not
# exist, and ordering against a unit that is not in the transaction is simply
# ignored.
After=cloud-init.service
Before=systemd-user-sessions.service sshd.service getty.target

[Service]
Type=oneshot
RemainAfterExit=no
# The command removes /.autorelabel itself when the relabel succeeds, which is
# what stops this from running again.
ExecStart=/usr/bin/omarchy-server-selinux relabel
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
