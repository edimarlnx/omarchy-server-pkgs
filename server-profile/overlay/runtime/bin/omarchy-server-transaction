#!/bin/bash

# omarchy:summary=Run an update in a throwaway snapshot of the root subvolume and swap it in at reboot
# omarchy:args=<run|rollback|status|prune|discard> [--keep N] [--no-swap] [--security-only] [--kexec|--no-reboot]
# omarchy:examples=omarchy server-transaction run | omarchy server-transaction rollback
# omarchy:requires-sudo=true

# A transactional update never writes to the running system. It takes a
# writable btrfs snapshot of `@`, runs the whole upgrade inside it with the
# shared parts of the machine bound in (the ESP, /var/log, the package cache,
# /home), and only then decides whether that snapshot becomes the root the
# machine boots next. A failure anywhere in the middle costs a
# `btrfs subvolume delete` and nothing else: the live root was never opened for
# writing, so there is no half-updated state to recover from.
#
# ── how the new root is selected ────────────────────────────────────────────
#
# By RENAMING SUBVOLUMES, not by changing the boot configuration:
#
#     @            ->  @prev-<ts>       the root that was running
#     @tx-<ts>     ->  @                the root that was just built
#
# The alternatives were both worse on this profile.
#
#   `btrfs subvolume set-default` does nothing here: the kernel command line
#   carries `rootflags=subvol=@` explicitly (it is in /etc/kernel/cmdline, in
#   /etc/default/limine and in every entry limine-entry-tool generates), and an
#   explicit subvol always wins over the filesystem default.
#
#   Pointing the limine entry at the new subvolume means rewriting
#   /etc/kernel/cmdline, /etc/default/limine and limine.conf on every single
#   transaction, and every one of those files is regenerated by a pacman hook
#   inside the very transaction that is trying to change them. It also makes
#   the machine's boot configuration drift by one name per update, which is
#   exactly the thing that has to stay boring on a headless box.
#
# Renaming keeps the cmdline, the UKI, /etc/fstab and every hook byte for byte
# what they were. Nothing about the boot path changes, so nothing about the
# boot path can regress -- including under Secure Boot, where the signed chain
# is untouched. Rollback is then the same two renames in the other direction,
# which is the property that matters most at 3am.
#
# ── the two things renaming does not carry ──────────────────────────────────
#
#   Nested subvolumes. A btrfs snapshot is not recursive, so `.snapshots`,
#   var/lib/machines and var/lib/portables arrive in the new root as empty
#   directories. The first one is the record of every snapper snapshot the
#   machine has, so `swap_root` re-creates it and re-snapshots each retained
#   snapper snapshot into it (reflinked, so it costs no space and no time).
#   The other two are empty by definition and are simply re-created.
#
#   The ESP. /boot is one vfat partition shared by every root, so the
#   mkinitcpio and sbctl hooks that run inside the transaction overwrite the
#   UKI the CURRENTLY running kernel boots from. That is fine going forward and
#   fatal going backwards, so the pre-transaction UKI and limine.conf are
#   copied to /boot/omarchy-tx/prev/ first. A failed transaction restores them
#   immediately; a rollback restores them before swapping the names back. They
#   are already signed, so nothing has to be re-signed on the way out.

set -euo pipefail

state_dir=/var/lib/omarchy-server
state_file="$state_dir/transaction"
# On the ESP on purpose: it is the one filesystem that belongs to no root
# subvolume, so a rescue shell can reach these copies whichever root it booted.
esp_backup=/boot/omarchy-tx/prev
# How many previous roots to keep. One is enough to roll back the update that
# just ran; the snapper snapshots are the deeper history.
keep=1
no_swap=0
restart_args=()
# Extra packages to install or reinstall inside the transaction, after the
# upgrade. This is how anything that changes the package set gets to be
# transactional too -- an addon, a one-off `pacman -S`, a kernel reinstall to
# force a fresh initramfs -- without ever writing to the running root.
with_packages=()
# Upgrade everything (the default), or only the packages named with --with.
# omarchy-server-update passes this for a --security-only run: the transaction,
# the swap and the rollback are the same, only the package half is narrower.
security_only=0

if ((EUID != 0)); then
  echo "omarchy-server-transaction: must run as root." >&2
  exit 2
fi

action="${1:-}"
[[ -n $action ]] && shift
while (($#)); do
  case "$1" in
    --keep)
      keep="${2:?--keep needs a count}"
      shift 2
      ;;
    --no-swap)
      no_swap=1
      shift
      ;;
    --with)
      with_packages+=("${2:?--with needs a package name}")
      shift 2
      ;;
    --security-only)
      security_only=1
      shift
      ;;
    --kexec | --no-reboot)
      restart_args+=("$1")
      shift
      ;;
    -h | --help)
      action=help
      shift
      ;;
    *)
      echo "omarchy-server-transaction: unknown option '$1'. Try --help." >&2
      exit 2
      ;;
  esac
done

log() { echo -e "\e[32m$*\e[0m"; }
warn() { echo -e "\e[33m$*\e[0m" >&2; }
fatal() {
  echo -e "\e[31momarchy-server-transaction: $*\e[0m" >&2
  exit 1
}

# ── where the root filesystem actually is ───────────────────────────────────
#
# SOURCE comes back as `/dev/vda2[/@]`; the bracket is the subvolume the mount
# was made from, which is the one piece of information the whole command turns
# on and the one `findmnt -o SOURCE` will not give separately.
# The SELinux context of one path, empty on a machine without SELinux or a
# coreutils that was not built against libselinux.
get_context() { ls -Zd "$1" 2>/dev/null | awk '{ print $1 }'; }

root_device() { findmnt -no SOURCE / | sed 's/\[.*//'; }
root_subvol() { findmnt -no SOURCE / | sed -n 's/.*\[\(.*\)\]/\1/p'; }

top=""
newroot=""

# Unmount in reverse order and always: an aborted run that leaves the
# transaction's /proc bound is a machine that cannot unmount its own root.
unmount_chroot() {
  local target
  if [[ -n $newroot ]] && mountpoint -q "$newroot" 2>/dev/null; then
    # Plain umount first and lazy only as a fallback: a lazy unmount detaches
    # the tree but keeps the mount alive until its last reference goes, and the
    # top-level umount that follows would then find it busy.
    while read -r target; do
      umount "$target" 2>/dev/null || umount -l "$target" 2>/dev/null || true
    done < <(findmnt -Rno TARGET "$newroot" | tac)
  fi
  newroot=""
  return 0
}

cleanup_mounts() {
  unmount_chroot
  [[ -n $top ]] && mountpoint -q "$top" 2>/dev/null && umount -R "$top" 2>/dev/null || true
  return 0
}

# The counterpart of mount_top, and the last thing every action does. The
# directory goes with it: it lives under /run, so a leftover would survive
# until the next boot and confuse the next run's `findmnt`.
unmount_top() {
  [[ -n $top ]] || return 0
  umount -R "$top" 2>/dev/null || umount -l "$top" 2>/dev/null || true
  rmdir "$top" 2>/dev/null || true
  top=""
  return 0
}

# No mount options: btrfs mount options are properties of the superblock, not
# of the individual mount, so this second mount of an already-mounted
# filesystem inherits the compression and cache settings / was mounted with.
# Passing them again is at best redundant and at worst a conflict the kernel
# refuses.
mount_top() {
  top=$(mktemp -d /run/omarchy-tx.XXXXXX)
  mount -o subvolid=5 "$(root_device)" "$top"
  # Subvolume 5 is the one subvolume this machine never mounts in normal
  # operation, so its directory has no `security.selinux` xattr and arrives as
  # `unlabeled_t` -- a directory that even `sysadm_t` may not rename in, which
  # is precisely what swap_root does. Labelling it once is the repair: it is a
  # directory holding root filesystems, so `root_t` is what it would have had
  # if a relabel had ever reached it. Not a `context=` mount option -- SELinux
  # mount options have to agree across every mount of one superblock, and this
  # filesystem is already mounted at /. The label is an xattr on subvolume 5's
  # own directory, so this is done once and every later transaction finds it
  # already there. No `:s0`: the policy this profile ships has MLS disabled and
  # chcon refuses a context carrying a level it does not know. Measured:
  # reports/2026-08-29-transactional-selinux.md.
  local context
  context=$(get_context "$top")
  if [[ -e /sys/fs/selinux/enforce ]] &&
    [[ $context == "?" || $context == *unlabeled_t* ]]; then
    chcon system_u:object_r:root_t "$top" ||
      warn "could not label $top; the swap will be refused under enforcing."
  fi
  # Nothing under the transaction may propagate OUT of it. This directory is
  # inside /run, systemd leaves /run shared, and mount_chroot binds /run back
  # into the transaction -- so the transaction's mount tree ends up mirrored
  # under itself in the host's peer group, and the teardown's unmounts reach
  # the live machine. Measured before this line: one transaction unmounted the
  # host's /sys/fs/selinux, /sys/fs/cgroup, /sys/kernel/debug and six more, and
  # SELinux read as `Disabled` until the next reboot.
  mount --make-rslave "$top"
}

# ── the transaction ─────────────────────────────────────────────────────────

save_esp() {
  rm -rf "$esp_backup"
  install -d "$esp_backup"
  cp -a /boot/limine.conf "$esp_backup/" 2>/dev/null || true
  if [[ -d /boot/EFI/Linux ]]; then
    install -d "$esp_backup/EFI-Linux"
    cp -a /boot/EFI/Linux/. "$esp_backup/EFI-Linux/" 2>/dev/null || true
  fi
}

restore_esp() {
  [[ -d $esp_backup ]] || return 0
  [[ -f $esp_backup/limine.conf ]] && cp -a "$esp_backup/limine.conf" /boot/limine.conf
  if [[ -d $esp_backup/EFI-Linux ]]; then
    install -d /boot/EFI/Linux
    cp -a "$esp_backup/EFI-Linux/." /boot/EFI/Linux/
  fi
  return 0
}

# The subvolumes nested inside `@` that the snapshot flattened into empty
# directories. `.snapshots` is handled by swap_root, which has the previous
# root to copy from; these two are empty by definition.
recreate_nested() {
  local dir
  for dir in var/lib/machines var/lib/portables; do
    [[ -d $newroot/$dir ]] || continue
    rmdir "$newroot/$dir" 2>/dev/null || continue
    btrfs subvolume create "$newroot/$dir" >/dev/null
  done
}

# The parts of the machine that are NOT the root subvolume and must be the same
# object inside the transaction as outside it: the ESP (so the UKI the hooks
# write is the one the machine boots), /var/log (so the update's own log
# survives a discarded transaction), the package cache (so nothing is
# downloaded twice) and /home.
#
# /run is bound because pacman needs /etc/resolv.conf, which is a symlink into
# it. That also makes the host's systemd reachable, which is why SYSTEMD_OFFLINE
# is exported below: a package that runs `systemctl enable` must write into the
# transaction's /etc, not into the live one.
mount_chroot() {
  # The transaction's root bound onto itself, first: without it the chroot's /
  # is a plain directory rather than a mount point, and pacman's CheckSpace
  # aborts every transaction with "could not determine root mount point /".
  # This is the one line arch-chroot exists for.
  mount --bind "$newroot" "$newroot"
  mount --bind /boot "$newroot/boot"
  mount --bind /var/log "$newroot/var/log"
  mount --bind /var/cache/pacman/pkg "$newroot/var/cache/pacman/pkg"
  mount --bind /home "$newroot/home"
  mount -t proc proc "$newroot/proc"
  mount --rbind /sys "$newroot/sys"
  mount --make-rslave "$newroot/sys"
  mount --rbind /dev "$newroot/dev"
  mount --make-rslave "$newroot/dev"
  # --bind and not --rbind: this command's own top-level mount lives under
  # /run, so a recursive bind would copy the transaction into itself and leave
  # a mount tree that cannot be unwound. Nothing under /run that the update
  # needs is a mount of its own -- resolv.conf is a plain file on the tmpfs.
  mount --bind /run "$newroot/run"
  mount --bind /tmp "$newroot/tmp"
  # And the whole tree is a slave, for the reason mount_top gives: it still
  # SEES anything the host mounts, it never sends an unmount back. `--rbind` of
  # a shared mount produces a peer of the original, so this has to be said
  # again after the binds rather than only once on $top.
  mount --make-rslave "$newroot"
}

run_in_chroot() {
  chroot "$newroot" /usr/bin/env -i \
    HOME=/root \
    TERM=dumb \
    LC_ALL=C \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/bin \
    SYSTEMD_OFFLINE=1 \
    OMARCHY_NONINTERACTIVE=1 \
    OMARCHY_UPDATE_UNATTENDED=1 \
    OMARCHY_PATH=/usr/share/omarchy \
    /bin/bash -s
}

# The update itself, as it runs inside the transaction. This is deliberately
# omarchy-update's package half rather than omarchy-update itself: the steps
# that half is missing are the ones that have no meaning in a chroot -- the
# `script` re-exec, the systemd inhibitor, the snapper snapshot (taken outside,
# on the live root, before any of this) and omarchy-update-restart (there is
# nothing running in here to restart).
transaction_script() {
  # An empty array and not `('')`: `printf '%q ' ` with no arguments still
  # prints one empty field, which would arrive as a package named "" and take
  # `pacman -S` down with "target not found".
  if ((${#with_packages[@]})); then
    printf 'extra_packages=(%s)\n' "$(printf '%q ' "${with_packages[@]}")"
  else
    printf 'extra_packages=()\n'
  fi
  printf 'security_only=%d\n' "$security_only"
  cat <<'CHROOT'
set -uo pipefail
rc=0

if command -v omarchy-update-keyring >/dev/null; then
  omarchy-update-keyring || { echo "keyring step failed" >&2; exit 1; }
fi

if ((security_only)); then
  # The databases still have to be refreshed -- the fixed version has to be
  # findable -- but only the named packages are installed from them. That is a
  # partial upgrade by definition, and it is what --security-only asks for.
  echo "== pacman -Sy (security-only)"
  pacman -Sy --noconfirm --noprogressbar || exit 1
else
  echo "== pacman -Syu"
  pacman -Syu --noconfirm --noprogressbar --overwrite '/usr/share/omarchy/*' || exit 1
fi

if ((${#extra_packages[@]})); then
  # --needed only in a security-only transaction: there the packages are a fix
  # list and reinstalling one already at the fixed version buys nothing, while
  # a plain `--with` is how a kernel gets deliberately REinstalled to rebuild
  # its initramfs.
  needed=()
  ((security_only)) && needed=(--needed)
  echo "== pacman -S ${needed[*]} ${extra_packages[*]}"
  pacman -S --noconfirm --noprogressbar ${needed[@]+"${needed[@]}"} "${extra_packages[@]}" || exit 1
fi

if command -v omarchy-migrate >/dev/null; then
  echo "== migrations"
  omarchy-migrate || rc=1
fi

if command -v omarchy-hook >/dev/null; then
  echo "== post-update hook"
  omarchy-hook post-update || rc=1
fi

if command -v paccache >/dev/null; then
  echo "== prune package cache"
  paccache -rk2 || true
fi

exit "$rc"
CHROOT
}

# ── swapping the names ──────────────────────────────────────────────────────
#
# Two renames with no atomicity between them: for the width of one syscall the
# filesystem has no subvolume called `@`. Losing power inside that window drops
# the next boot into the initramfs emergency shell, where
# `mount /dev/<root> /mnt -o subvolid=5 && mv /mnt/@prev-<ts> /mnt/@` is the
# whole repair. btrfs offers no atomic rename pair, and every alternative that
# does (set-default, a rewritten cmdline) trades this microsecond for a boot
# configuration that changes on every update. See docs/transactional.md.
swap_root() {
  local tx="$1" prev="@prev-$2"

  # Housekeeping first, so nothing but the two renames sits in the window.
  prune_previous "$((keep - 1))"

  # Both renames are checked, and the first is undone if the second fails. A
  # rename that was refused used to be printed by mv and then reported as
  # "Swapped in:" -- a machine that had updated nothing, saying it had. The
  # caller tests this function's status rather than relying on `set -e`, which
  # does not reach out of the command substitution it is called in.
  mv "$top/@" "$top/$prev" ||
    fatal "could not rename @ to $prev; the machine still boots the old root"
  mv "$top/$tx" "$top/@" || {
    mv "$top/$prev" "$top/@" ||
      fatal "renaming $tx to @ failed AND @ could not be restored from $prev." \
        "Repair from the initramfs: mount the device with -o subvolid=5 and" \
        "rename $prev back to @."
    fatal "could not rename $tx to @; the machine still boots the old root"
  }

  # `.snapshots` went with the old root. Re-create it in the new one and
  # re-snapshot each retained snapper snapshot: reflinks, so this is metadata
  # only, and snapper reads the directory plus info.xml rather than any
  # subvolume id.
  local snapdir="$top/@/.snapshots" src number
  rmdir "$snapdir" 2>/dev/null || true
  if [[ ! -e $snapdir ]] && btrfs subvolume create "$snapdir" >/dev/null; then
    for src in "$top/$prev"/.snapshots/*/; do
      [[ -d $src ]] || continue
      number=$(basename "$src")
      [[ $number =~ ^[0-9]+$ ]] || continue
      mkdir -p "$snapdir/$number"
      [[ -f $src/info.xml ]] && cp -a "$src/info.xml" "$snapdir/$number/"
      [[ -d $src/snapshot ]] &&
        btrfs subvolume snapshot -r "$src/snapshot" "$snapdir/$number/snapshot" >/dev/null
    done
  fi

  echo "$prev"
}

prune_previous() {
  local limit="$1" candidate
  local -a previous=()
  mapfile -t previous < <(btrfs subvolume list "$top" | awk '{print $NF}' |
    grep -E '^@(prev|failed)-[^/]+$' | sort -r)
  local index=0
  for candidate in "${previous[@]}"; do
    if ((index < limit)); then
      ((index++)) || true
      continue
    fi
    delete_root "$top/$candidate"
  done
}

# A root subvolume carries nested subvolumes -- `.snapshots`, and one snapshot
# subvolume per snapper number inside it -- and btrfs refuses to delete a
# subvolume that still has children. So: every subvolume whose path is under
# this one, deepest first, then the root itself. Paths from `btrfs subvolume
# list` are relative to the filesystem's top level, which is what $top is
# mounted at.
delete_root() {
  local path="$1" base child
  base=$(basename "$path")
  while read -r child; do
    [[ -n $child ]] || continue
    btrfs subvolume delete "$top/$child" >/dev/null 2>&1 || true
  done < <(btrfs subvolume list "$top" | awk '{print $NF}' | grep "^$base/" |
    awk '{ n = gsub("/", "/"); print n, $0 }' | sort -rn | cut -d' ' -f2-)
  btrfs subvolume delete "$path" >/dev/null 2>&1 ||
    warn "could not delete $path"
}

write_state() {
  install -d "$1$state_dir"
  cat >"$1$state_file" <<EOF
TX=$2
PREV=$3
CREATED=$4
STATE=$5
EOF
}

# ── actions ─────────────────────────────────────────────────────────────────

do_run() {
  local subvol
  subvol=$(root_subvol)
  if [[ $subvol != /@ && $subvol != @ ]]; then
    echo "omarchy-server-transaction: the running root is '$subvol', not '@'." >&2
    echo "A transaction can only be built from the machine's own root. Roll back first." >&2
    exit 1
  fi

  local stamp tx started
  stamp=$(date +%Y%m%d%H%M%S)
  tx="@tx-$stamp"
  started=$(date -Is)

  # Step one, unchanged from an in-place update: the snapper snapshot on the
  # live root. It is what the limine menu offers and it is taken before
  # anything else so it is a picture of the machine as it was.
  if command -v omarchy-snapshot >/dev/null; then
    omarchy-snapshot create || warn "Continuing the transaction without a snapper snapshot."
  fi

  trap cleanup_mounts EXIT
  mount_top

  log "\nBuilding transaction $tx"
  btrfs subvolume snapshot "$top/@" "$top/$tx" >/dev/null

  newroot="$top/$tx"
  recreate_nested
  save_esp
  mount_chroot

  local used_before used_after rc=0
  used_before=$(btrfs filesystem usage -b "$top" | awk '/^[[:space:]]*Used:/ {print $2; exit}')

  log "\nRunning the update inside $tx"
  transaction_script | run_in_chroot || rc=$?

  used_after=$(btrfs filesystem usage -b "$top" | awk '/^[[:space:]]*Used:/ {print $2; exit}')

  # Unmount the bind mounts before touching the subvolume either way: a bound
  # /proc makes `btrfs subvolume delete` fail and a bound /boot makes the swap
  # rename a lie. The top-level mount stays: everything below still needs it.
  unmount_chroot

  if ((rc != 0)); then
    warn "\nThe update failed inside the transaction (exit $rc)."
    restore_esp
    delete_root "$top/$tx"
    echo "Discarded $tx. The running system was not modified."
    exit "$rc"
  fi

  local delta=$((used_after - used_before))
  log "\nTransaction succeeded (+$((delta / 1024 / 1024)) MiB on the filesystem)"

  if ((no_swap)); then
    echo "--no-swap: $tx is left in place and the machine still boots @."
    unmount_top
    exit 0
  fi

  local want_kexec=0 allow_reboot=1 argument
  for argument in ${restart_args[@]+"${restart_args[@]}"}; do
    [[ $argument == --kexec ]] && want_kexec=1
    [[ $argument == --no-reboot ]] && allow_reboot=0
  done

  local prev
  if ! prev=$(swap_root "$tx" "$stamp"); then
    unmount_top
    exit 1
  fi
  write_state "$top/@/" "$tx" "$prev" "$started" pending
  log "Swapped in: @ is now the updated root, $prev is what was running."

  # Every byte of the change is in the new root and nothing in the running one
  # moved, so there is nothing to classify and nothing to restart in place: a
  # transaction is always a reboot, which is the trade it makes. The marker
  # therefore belongs in the root that will be running when someone reads it,
  # and only when this run is not taking the reboot itself.
  if ((allow_reboot == 0)); then
    install -d -m 700 "$top/@/root/.local/state/omarchy"
    : >"$top/@/root/.local/state/omarchy/reboot-required"
  fi

  unmount_top
  trap - EXIT

  if ((allow_reboot == 0)); then
    echo "--no-reboot: the machine boots the new root at the next reboot."
    exit 0
  fi

  if ((want_kexec)) && command -v omarchy-server-kexec >/dev/null && omarchy-server-kexec load; then
    omarchy-state clear reboot-required || true
    log "kexec image loaded; taking the reboot now"
    exec systemctl kexec
  fi

  log "Rebooting into the new root"
  exec systemctl reboot
}

do_rollback() {
  trap cleanup_mounts EXIT
  mount_top

  local prev
  prev=$(btrfs subvolume list "$top" | awk '{print $NF}' |
    grep -E '^@prev-[^/]+$' | sort -r | head -1)
  if [[ -z $prev ]]; then
    echo "omarchy-server-transaction: no @prev-* subvolume to roll back to." >&2
    exit 1
  fi

  local stamp
  stamp=$(date +%Y%m%d%H%M%S)

  # The ESP first: the UKI on it belongs to the root that is about to be
  # replaced, and the kernel modules that match it are about to go away.
  restore_esp

  mv "$top/@" "$top/@failed-$stamp"
  mv "$top/$prev" "$top/@"

  write_state "$top/@/" "" "@failed-$stamp" "$(date -Is)" rolled-back

  log "Rolled back to $prev (the root that failed is kept as @failed-$stamp)."
  unmount_top
  trap - EXIT

  ((${#restart_args[@]})) && [[ " ${restart_args[*]} " == *" --no-reboot "* ]] && exit 0
  log "Rebooting"
  exec systemctl reboot
}

do_status() {
  local subvol
  subvol=$(root_subvol)
  echo "root subvolume: $subvol"
  echo "device:         $(root_device)"

  trap cleanup_mounts EXIT
  mount_top

  # The state file is written into the root a transaction produced, so a
  # machine that has swapped but not yet rebooted is still running the OLD root
  # and would report "none". Read it out of `@` rather than out of `/`, which
  # is the same file once the reboot has happened.
  if [[ -r $top/@$state_file ]]; then
    echo "last transaction:"
    sed 's/^/  /' "$top/@$state_file"
    if [[ $subvol != /@ && $subvol != @ ]]; then
      echo "  NOTE: this machine is running $subvol, not @ -- a swap is waiting on a reboot."
    fi
  else
    echo "last transaction: none recorded"
  fi

  echo "root subvolumes on the filesystem:"
  btrfs subvolume list "$top" | awk '{print $NF}' | grep -E '^@[^/]*$' | sed 's/^/  /' || true
  echo "saved boot files: $([[ -d $esp_backup ]] && echo "$esp_backup" || echo none)"
}

do_prune() {
  trap cleanup_mounts EXIT
  mount_top
  prune_previous "$keep"
  echo "kept the $keep most recent previous root(s)."
}

# A transaction left behind by `--no-swap`, or by a run that was killed between
# the snapshot and the swap. Never touches @, @prev-* or @failed-*.
do_discard() {
  trap cleanup_mounts EXIT
  mount_top
  local candidate found=0
  while read -r candidate; do
    [[ -n $candidate ]] || continue
    delete_root "$top/$candidate"
    echo "discarded $candidate"
    found=1
  done < <(btrfs subvolume list "$top" | awk '{print $NF}' | grep -E '^@tx-[^/]+$')
  ((found)) || echo "no unswapped transaction to discard."
}

case "$action" in
  run) do_run ;;
  rollback) do_rollback ;;
  status) do_status ;;
  prune) do_prune ;;
  discard) do_discard ;;
  help | -h | --help | "")
    echo "Usage: omarchy-server-transaction <run|rollback|status|prune|discard> [flags]"
    echo
    echo "  run       build a transaction, update inside it, swap it in and reboot"
    echo "  rollback  swap the previous root back in and reboot"
    echo "  status    which root is running, what the last transaction did"
    echo "  prune     delete all but the --keep most recent previous roots"
    echo "  discard   delete an unswapped @tx-* left by --no-swap or a killed run"
    echo
    echo "Flags:"
    echo "  --with PKG    also install/reinstall PKG inside the transaction (repeatable)"
    echo "  --security-only  refresh the databases but upgrade only the --with packages"
    echo "  --keep N      previous roots to retain (default 1)"
    echo "  --no-swap     build and update the transaction, do not swap it in"
    echo "  --kexec       take the reboot with kexec into the signed UKI"
    echo "  --no-reboot   swap the names and leave the reboot to someone else"
    ;;
  *)
    echo "omarchy-server-transaction: unknown command '$action'. Try --help." >&2
    exit 2
    ;;
esac
