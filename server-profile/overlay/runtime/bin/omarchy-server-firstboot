#!/bin/bash

# omarchy:summary=Give a machine booted from a shared image an identity of its own
# omarchy:args=[--force]
# omarchy:examples=omarchy server-firstboot | omarchy server-firstboot --force
# omarchy:requires-sudo=true

# The other half of first boot.
#
# cloud-init owns everything the PLATFORM knows: hostname, users, ssh
# authorized keys, the size of the root filesystem. This command owns the two
# things a shared image must not carry and no metadata service can supply:
#
#   ssh host keys    A generalized image has none (omarchy-server-generalize
#                    deletes them). Every machine booted from it has to make
#                    its own, before sshd offers a fingerprint to anyone.
#                    Arch's sshdgenkeys.service would do this too; this runs
#                    first and ordered explicitly, because "the host keys
#                    happen to be regenerated by a unit in another package" is
#                    not a property to leave undocumented on an image whose
#                    whole point is being copied.
#
#   Secure Boot keys A PK/KEK/db triplet is what makes a machine's boot chain
#                    ITS boot chain. Baking one into an image would hand every
#                    machine that boots it the private key that signs the
#                    others' kernels -- which is the opposite of what Secure
#                    Boot is for. So an image built with --secboot ships sbctl,
#                    the cmdline drop-in and a signed-by-nobody ESP, and the
#                    keys are generated HERE, on this machine, once.
#
# Runs once. /var/lib/omarchy/firstboot-done is the marker; --force ignores it,
# which is what an operator repairing a half-finished first boot wants.

set -uo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
state_dir=/var/lib/omarchy
marker="$state_dir/firstboot-done"
secureboot_marker="$state_dir/firstboot-secureboot"
limine_marker="$state_dir/firstboot-limine"

force=0
case "${1:-}" in
  --force) force=1 ;;
  "") ;;
  -h | --help)
    echo "Usage: omarchy-server-firstboot [--force]"
    echo
    echo "Regenerates the ssh host keys a generalized image does not carry and,"
    echo "when the image asked for it, generates and enrolls this machine's own"
    echo "Secure Boot keys. Runs once; --force runs it again."
    exit 0
    ;;
  *)
    echo "omarchy-server-firstboot: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
esac

if ((EUID != 0)); then
  exec sudo -E "$0" "$@"
fi

if [[ -f $marker && $force -eq 0 ]]; then
  echo "firstboot: already done ($marker); --force to run again"
  exit 0
fi

install -d -m 0755 "$state_dir"

# ── ssh host identity ───────────────────────────────────────────────────────
# `ssh-keygen -A` generates only the types that are missing, so this is a no-op
# on a machine that already has them and the whole job on one that does not.
regenerate_host_keys() {
  local before after
  before=$(ls /etc/ssh/ssh_host_*_key 2>/dev/null | wc -l)
  ssh-keygen -A
  after=$(ls /etc/ssh/ssh_host_*_key 2>/dev/null | wc -l)
  echo "firstboot: ssh host keys $before -> $after"
  # The fingerprint goes in the journal on purpose: on a cloud instance with no
  # console, `journalctl -u omarchy-server-firstboot` is where an operator who
  # cares about trust-on-first-use reads the fingerprint they are about to
  # accept -- and the platform's serial console shows the same lines.
  local key
  for key in /etc/ssh/ssh_host_*_key.pub; do
    [[ -f $key ]] || continue
    echo "firstboot: $(ssh-keygen -l -f "$key")"
  done
}

# ── Secure Boot ─────────────────────────────────────────────────────────────
# Only for an image that was built for it: the marker is written by
# omarchy-server-generalize when it deletes the build machine's keys, so a
# machine that finds it knows sbctl is installed, the cmdline already carries
# lockdown=integrity, and the ESP is signed with keys that no longer exist.
create_secure_boot_keys() {
  [[ -f $secureboot_marker ]] || return 0

  if ! command -v sbctl >/dev/null; then
    echo "firstboot: the image asked for Secure Boot but sbctl is not installed" >&2
    return 1
  fi

  # Keys first: creating them re-signs nothing by itself, but every hook that
  # signs (limine-entry-tool, mkinitcpio's sbctl hook, sbctl's own pacman hook)
  # looks for them, and secureboot-server.sh registers the ESP binaries in
  # sbctl's database and signs them with the keys it just made.
  echo "firstboot: generating this machine's own Secure Boot keys"
  # shellcheck disable=SC1090
  source "$OMARCHY_INSTALL/server/secureboot-server.sh"
}

enroll_secure_boot() {
  [[ -f $secureboot_marker ]] || return 0
  command -v sbctl >/dev/null || return 0

  # Enrollment is separate, and conditional on the firmware. `enroll` verifies
  # the chain before it writes a PK and refuses when the firmware already owns
  # one, so calling it unconditionally is safe: on a machine whose firmware is
  # not in Setup Mode it prints what to do and changes nothing.
  echo "firstboot: enrolling into the firmware, if it will have them"
  if omarchy-server-secureboot enroll; then
    echo "firstboot: Secure Boot keys enrolled"
    rm -f "$secureboot_marker"
  else
    echo "firstboot: the firmware did not accept an enrollment." >&2
    echo "           The chain is signed with this machine's keys; put the" >&2
    echo "           firmware into Setup Mode and run:" >&2
    echo "               sudo omarchy-server-secureboot enroll" >&2
    # The marker STAYS: a machine whose firmware was not ready is a machine
    # this should try again on, not one that has silently given up.
  fi
}

# ── entropy seed ────────────────────────────────────────────────────────────
# systemd-random-seed.service saves the pool to /var/lib/systemd/random-seed
# when it STOPS, which is part of every shutdown -- including the shutdown that
# ends the image build. So a file the generalize deleted is a file that exists
# again in the image, and it is the same file on every machine booted from it.
#
# systemd does not credit entropy from that file unless
# SYSTEMD_RANDOM_SEED_CREDIT says so, which is why this is a tidy-up rather
# than an emergency. Replacing it here means the file this machine saves at its
# next shutdown is its own.
reseed() {
  rm -f /var/lib/systemd/random-seed
  if systemctl restart systemd-random-seed.service >/dev/null 2>&1; then
    echo "firstboot: entropy seed replaced with this machine's own"
  else
    echo "firstboot: could not restart systemd-random-seed" >&2
  fi
}

# ── the boot entry ──────────────────────────────────────────────────────────
# limine.conf tags every OS entry with the machine-id of the machine that wrote
# it (`comment: machine-id=<id> order-priority=50`). An image carries the BUILD
# machine's tag, and it cannot be removed before the copy: it is the entry the
# image boots from.
#
# The consequence is not cosmetic. limine-snapper-sync writes its history under
# the RUNNING machine's id and attaches snapshot entries to the OS entry that
# carries it -- of which there is none, so a machine from the image quietly
# lists no snapshots and offers no rollback from the boot menu. Measured in
# reports/2026-08-29-cloud-image.md.
#
# `limine-update` regenerates the initramfs and the UKI and writes an entry for
# THIS machine; the build machine's entry is then removed by its id. It runs
# after the Secure Boot keys are created, because the UKI it writes has to be
# signed with the keys this machine now owns.
retag_boot_entry() {
  [[ -f $limine_marker ]] || return 0
  local old
  old=$(tr -d '[:space:]' <"$limine_marker")

  if ! command -v limine-update >/dev/null; then
    echo "firstboot: limine-update is not installed; the boot entry keeps the build machine's id" >&2
    return 1
  fi

  echo "firstboot: regenerating the boot entry for machine-id $(cat /etc/machine-id)"
  if ! limine-update; then
    echo "firstboot: limine-update failed; leaving $limine_marker for a retry" >&2
    return 1
  fi

  if [[ -n $old ]] && command -v limine-entry-tool >/dev/null; then
    if limine-entry-tool --remove-entry "$old" >/dev/null 2>&1; then
      echo "firstboot: removed the build machine's boot entry ($old)"
    else
      echo "firstboot: no boot entry left for $old"
    fi
  fi
  rm -f "$limine_marker"
}

echo "=== omarchy-server-firstboot — $(date -Is) ==="
regenerate_host_keys
reseed
create_secure_boot_keys
retag_boot_entry
enroll_secure_boot

date -Is >"$marker"
echo "firstboot: done"
