#!/bin/bash

# omarchy:summary=Load the signed UKI for a kexec, so a required reboot skips the firmware
# omarchy:args=[load|status|unload]
# omarchy:examples=omarchy server-kexec load && systemctl kexec
# omarchy:requires-sudo=true

# A reboot on a server is mostly firmware: POST, device init, option ROMs, the
# bootloader's menu. kexec skips all of it -- the running kernel loads the next
# kernel into memory and jumps to it -- and on this profile there is a specific
# reason it is not simply "load /boot/vmlinuz": the boot image is a **UKI**, a
# PE binary carrying the kernel, the initramfs and the command line in its own
# sections, signed by the machine's own Secure Boot key.
#
# That shapes the whole command.
#
#   * kexec_load(2), the classic syscall, takes a bzImage and an initrd as
#     separate files and does no signature check at all. Under the
#     `lockdown=integrity` this profile's UKI bakes in, the kernel refuses it
#     outright -- which is the point of lockdown.
#   * kexec_file_load(2) takes one file descriptor and verifies its signature
#     inside the kernel before accepting it. `kexec --kexec-file-syscall` is
#     how kexec-tools reaches it, and it is the only route under lockdown.
#
# The keyring question is the interesting one, and it is not the same question
# module signing lost. Module signature verification consults `.builtin` and
# `.machine`, so a certificate enrolled in the firmware `db` -- which is what
# this profile does -- lands in `.platform` and is never consulted (see
# docs/secure-boot.md §8). kexec's PE verification path explicitly *does*
# accept `.platform`. That was the premise, and it is **measured true**: this
# machine kexecs into a kernel signed by the same key that cannot sign a
# module.
#
# What is measured FALSE is handing the UKI itself to kexec_file_load. The
# kernel's PE verifier reports it as
#
#   PEFILE: Unsigned PE binary
#   Lockdown: kexec: kexec of unsigned images is restricted
#
# even though `sbctl verify` calls it signed and the firmware boots it: the
# signature layout systemd-ukify produces is not the one the kernel's `pefile`
# parser accepts. So the working route unpacks the UKI instead -- .linux,
# .initrd and .cmdline are three sections of a PE anyone can read with objcopy
# -- signs the extracted kernel with the machine's own key, and loads that.
#
# That is not a weakening, and it is worth being explicit about why: the bytes
# signed are the same kernel that was already inside a UKI this machine's
# firmware verified, the key is the same key, and the kernel still verifies the
# signature before accepting the image. Nothing is trusted that was not trusted
# before; the signature is simply re-expressed in the format the kexec path can
# read. The scratch copies live in /var/lib/omarchy/kexec, root-only.
#
# This command only loads. Taking the reboot is `systemctl kexec`, which is
# systemd's ordinary shutdown transaction with a jump at the end instead of a
# firmware reset -- units stop, filesystems are unmounted, and nothing is lost.

set -euo pipefail

esp=/boot
uki_dir="$esp/EFI/Linux"

require_root() {
  if ((EUID != 0)); then
    exec sudo -E "$0" "$@"
  fi
}

have_kexec() { command -v kexec >/dev/null 2>&1; }

# find_uki prints the image to load. The fallback UKI is deliberately excluded:
# it exists for the case where the normal one does not boot, and kexecing into
# it hides exactly the failure it is there to survive.
find_uki() {
  local candidate newest=""
  for candidate in "$uki_dir"/*.efi; do
    [[ -f $candidate ]] || continue
    [[ $candidate == *-fallback.efi ]] && continue
    if [[ -z $newest || $candidate -nt $newest ]]; then
      newest="$candidate"
    fi
  done
  [[ -n $newest ]] || return 1
  printf '%s\n' "$newest"
}

case "${1:-load}" in
  status)
    if ! have_kexec; then
      echo "kexec-tools is not installed (omarchy-server-addon kexec)"
      exit 1
    fi
    echo "kexec:  $(command -v kexec)"
    if uki=$(find_uki); then
      echo "image:  $uki"
    else
      echo "image:  none found in $uki_dir"
    fi
    # /sys/kernel/kexec_loaded is 1 once an image is in the reserved region.
    echo "loaded: $(cat /sys/kernel/kexec_loaded 2>/dev/null || echo unknown)"
    echo "lockdown: $(cat /sys/kernel/security/lockdown 2>/dev/null || echo none)"
    exit 0
    ;;
  unload)
    require_root "$@"
    have_kexec || exit 1
    kexec --unload
    exit 0
    ;;
  load) ;;
  -h | --help)
    echo "Usage: omarchy-server-kexec [load|status|unload]"
    echo
    echo "  load     load the signed UKI into the kexec region (then: systemctl kexec)"
    echo "  status   report the tool, the image and whether one is already loaded"
    echo "  unload   drop a loaded image"
    exit 0
    ;;
  *)
    echo "omarchy-server-kexec: unknown command '$1'. Try --help." >&2
    exit 2
    ;;
esac

require_root "$@"

if ! have_kexec; then
  echo "omarchy-server-kexec: kexec-tools is not installed. Run: omarchy-server-addon kexec" >&2
  exit 1
fi

uki=$(find_uki) || {
  echo "omarchy-server-kexec: no UKI in $uki_dir" >&2
  exit 1
}

echo "omarchy-server-kexec: loading $uki"
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT

lockdown=$(cat /sys/kernel/security/lockdown 2>/dev/null || echo "")
locked_down() { [[ $lockdown == *"[integrity]"* || $lockdown == *"[confidentiality]"* ]]; }

# 1. The UKI as it stands. Measured to fail on this profile (the kernel calls
#    it an unsigned PE), and tried first anyway: it costs one syscall, it is
#    the route with nothing to unpack, and a kernel or a ukify that fixes the
#    layout should be picked up without anyone editing this file.
if kexec --load --kexec-file-syscall "$uki" 2>"$errors"; then
  echo "omarchy-server-kexec: loaded the UKI via kexec_file_load"
  exit 0
fi
echo "omarchy-server-kexec: kexec_file_load did not take the UKI:"
sed 's/^/  /' "$errors"

# 2. The UKI, unpacked. A UKI is a PE with the kernel in .linux, the initramfs
#    in .initrd and the command line in .cmdline; objcopy reads all three. The
#    kernel is then signed with the machine's own key -- the same key already
#    on the UKI, in the layout the kernel's verifier accepts -- and loaded.
work=/var/lib/omarchy/kexec
install -d -m 0700 "$work"
kernel="$work/vmlinuz"
initrd="$work/initrd.img"

if objcopy -O binary --only-section=.linux "$uki" "$kernel" 2>>"$errors" &&
  objcopy -O binary --only-section=.initrd "$uki" "$initrd" 2>>"$errors" &&
  [[ -s $kernel && -s $initrd ]]; then

  # The command line comes out of the UKI too, so the kexec'd kernel gets the
  # one this machine was actually built to boot with -- lockdown=integrity and
  # module.sig_enforce=1 included. --reuse-cmdline would read /proc/cmdline,
  # which is the same string on a first boot and NOT the same after an earlier
  # kexec chain; taking it from the image keeps every hop identical.
  cmdline=$(objcopy -O binary --only-section=.cmdline "$uki" /dev/stdout 2>/dev/null | tr -d '\0')

  if command -v sbctl >/dev/null && sbctl sign -o "$work/vmlinuz.signed" "$kernel" >/dev/null 2>>"$errors"; then
    kernel="$work/vmlinuz.signed"
    echo "omarchy-server-kexec: signed the extracted kernel with the machine's key"
  elif locked_down; then
    echo "omarchy-server-kexec: no sbctl to sign the extracted kernel, and lockdown will not take it unsigned." >&2
    sed 's/^/  /' "$errors" >&2
    exit 1
  fi

  load=(kexec --load --kexec-file-syscall "$kernel" --initrd="$initrd")
  [[ -n $cmdline ]] && load+=(--command-line="$cmdline")
  if "${load[@]}" 2>>"$errors"; then
    echo "omarchy-server-kexec: loaded the unpacked UKI via kexec_file_load"
    exit 0
  fi
fi
echo "omarchy-server-kexec: the unpacked UKI did not load either:" >&2
sed 's/^/  /' "$errors" >&2

# 3. The classic syscall, which verifies nothing. Only off lockdown, where
#    there is nothing to subvert -- under lockdown the kernel refuses it, and
#    trying anyway would only print a second, less informative error.
if locked_down; then
  echo "omarchy-server-kexec: lockdown is active, so the unverified syscall is not tried." >&2
  exit 1
fi
if kexec --load "$kernel" --initrd="$initrd" --reuse-cmdline 2>>"$errors"; then
  echo "omarchy-server-kexec: loaded via kexec_load"
  exit 0
fi

echo "omarchy-server-kexec: could not load an image; a firmware reboot is the way." >&2
sed 's/^/  /' "$errors" >&2
exit 1
