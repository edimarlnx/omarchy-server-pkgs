#!/bin/bash

# omarchy:summary=Strip a machine of its identity so its disk can become a shared image
# omarchy:args=--yes [--remove-user NAME] [--poweroff] [--no-factory]
# omarchy:examples=omarchy server-generalize --yes --remove-user imgbuild --poweroff
# omarchy:requires-sudo=true

# Turn THIS machine into an image.
#
# An installed machine and a cloud image differ by exactly one thing: an image
# is going to be copied. Everything that makes a machine itself -- its ssh host
# keys, its machine-id, its Secure Boot keys, its accounts, its logs, its
# entropy seed -- becomes a shared secret or a collision the moment the disk is
# duplicated. This command removes all of it, and leaves behind a machine that
# knows how to make a new identity on its next boot (cloud-init for what the
# platform knows, omarchy-server-firstboot for what it does not).
#
# It is deliberately a command of the PROFILE and not a step of the build
# pipeline: the machine is what knows where its own snapper store, its ESP and
# its btrfs top level are, and an operator who built a golden machine by hand
# is entitled to the same one-liner the pipeline uses.
#
#     sudo omarchy-server-generalize --yes --remove-user imgbuild --poweroff
#
# Two phases, and the split matters. The first runs in the caller's ssh
# session. The second (`--finish`, internal) is launched detached through
# systemd, because it removes the account the caller is logged in as, takes the
# @factory snapshot that must not contain that account, trims the filesystem
# and powers the machine off -- none of which can happen from inside a session
# that is about to be deleted.

set -uo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
state_dir=/var/lib/omarchy

confirmed=0
remove_users=()
remove_all_users=0
poweroff=0
factory=1
finish=0

while (($#)); do
  case "$1" in
    --yes) confirmed=1; shift ;;
    --remove-user) remove_users+=("${2:?--remove-user needs a name}"); shift 2 ;;
    --remove-all-users) remove_all_users=1; shift ;;
    --poweroff) poweroff=1; shift ;;
    --no-factory) factory=0; shift ;;
    --finish) finish=1; shift ;;
    -h | --help)
      cat <<'USAGE'
Usage: omarchy-server-generalize --yes [--remove-user NAME]... [--remove-all-users]
                                 [--poweroff] [--no-factory]

Strips this machine of everything that must not be copied, so its disk can be
turned into a shared image:

  cloud-init state      /var/lib/cloud, so the next boot is a first boot
  ssh host keys         regenerated by omarchy-server-firstboot
  machine-id            emptied, so systemd generates one per machine
  Secure Boot keys      deleted; regenerated and re-enrolled at first boot
  entropy seed          /var/lib/systemd/random-seed, credential.secret
  root's password       locked; an image must ship no credential at all
  accounts              --remove-user NAME (repeatable), or --remove-all-users
                        for every account with a uid of 1000 or more
  logs                  the journal and /var/log
  pacman cache          every downloaded package
  snapper snapshots     all of them; @factory is taken as the last act

Refuses to run without --yes.
USAGE
      exit 0
      ;;
    *)
      echo "omarchy-server-generalize: unknown option '$1'. Try --help." >&2
      exit 2
      ;;
  esac
done

if ((EUID != 0)); then
  echo "omarchy-server-generalize: must run as root." >&2
  exit 1
fi

step() { echo "generalize: $*"; }

# ── phase 2 ─────────────────────────────────────────────────────────────────
# Detached, because it deletes the account of the session that asked for it.
if ((finish)); then
  step "phase 2 (detached)"

  # --remove-all-users is what the image pipeline passes, and it is the only
  # form that is honest about the goal: an image ships NO account. A named list
  # can only remove the accounts whoever wrote the command line thought of, and
  # the installer creates one the caller did not ask for (`omarchy`, the
  # profile's owner account) — which is exactly the leftover an earlier build of
  # this pipeline shipped before anyone looked.
  if ((remove_all_users)); then
    while read -r account; do
      [[ -n $account ]] && remove_users+=("$account")
    done < <(awk -F: '$3 >= 1000 && $3 < 65534 { print $1 }' /etc/passwd)
  fi

  for account in "${remove_users[@]}"; do
    id "$account" >/dev/null 2>&1 || continue
    # -f: the ssh session that launched this is still shutting down and holds
    # the account's processes. Without it userdel refuses and the image ships
    # with a build account in it, which is the one outcome that must not happen
    # quietly.
    loginctl terminate-user "$account" >/dev/null 2>&1 || true
    sleep 2
    if userdel -r -f "$account" >/dev/null 2>&1; then
      step "removed user $account and its home"
    else
      step "WARNING: could not remove user $account" >&2
    fi
    # The installer names its drop-in `02_<user>` and a hand-made one is usually
    # just `<user>`. Both forms, and NOT a glob: this profile ships
    # /etc/sudoers.d/omarchy-passwd-tries and omarchy-tzupdate, and an
    # `omarchy*` glob deletes those too -- which an earlier version of this
    # command did, silently, on the account the installer happens to call
    # `omarchy`.
    for dropin in "/etc/sudoers.d/$account" /etc/sudoers.d/[0-9][0-9]_"$account"; do
      [[ -f $dropin ]] && rm -f "$dropin" && step "removed $dropin"
    done
    rm -rf "/home/$account"
  done
  # cloud-init regenerates this on the machine that boots the image; the copy
  # here is the BUILD machine's answer to the same question.
  rm -f /etc/sudoers.d/90-cloud-init-users

  # Anything with a uid of 1000 or more that is still here is a credential the
  # image would ship. Say so loudly rather than letting it pass as a blank line.
  remaining=$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1 }' /etc/passwd | tr '\n' ' ')
  if [[ -n ${remaining// /} ]]; then
    step "WARNING: accounts still present in the image: $remaining" >&2
  else
    step "no account with a uid of 1000 or more remains"
  fi

  # The entropy seed, again, and this is the one deletion that cannot be done in
  # phase 1: systemd-random-seed.service SAVES the pool to this file when it is
  # stopped, which is part of every shutdown -- so a file deleted before the
  # poweroff is a file that exists again in the image. Stopping the unit here
  # makes it write its last copy now; deleting it afterwards is what actually
  # sticks, as long as nothing restarts it before the power goes.
  #
  # It is belt and braces rather than the whole defence: systemd does not
  # CREDIT entropy from the seed file unless SYSTEMD_RANDOM_SEED_CREDIT says so,
  # and omarchy-server-firstboot replaces the file on the first boot regardless.
  systemctl stop systemd-random-seed.service >/dev/null 2>&1 || true
  rm -f /var/lib/systemd/random-seed
  step "entropy seed removed after stopping systemd-random-seed"

  # Anything a session wrote after phase 1: the wtmp record of the build login,
  # the last of the journal, the shell history of a root shell.
  rm -f /root/.bash_history /root/.ssh/known_hosts
  : >/var/log/wtmp 2>/dev/null || true
  : >/var/log/btmp 2>/dev/null || true
  : >/var/log/lastlog 2>/dev/null || true

  journalctl --rotate >/dev/null 2>&1 || true
  journalctl --vacuum-time=1s >/dev/null 2>&1 || true
  find /var/log -type f \( -name '*.log' -o -name '*.log.*' -o -name '*.gz' -o -name '*.old' \) -delete 2>/dev/null || true
  rm -rf /var/log/journal/* 2>/dev/null || true

  # @factory: a read-only snapshot of the generalized root, taken at the btrfs
  # TOP LEVEL beside @, which is where this profile's transactional update path
  # already lives (bin/omarchy-server-transaction). It is the state every
  # machine from this image starts from, and a factory reset is the same pair
  # of renames a transactional rollback is: @ -> @old, @factory-copy -> @.
  # docs/cloud-image.md writes the procedure down.
  if ((factory)); then
    top=$(mktemp -d /run/omarchy-generalize.XXXXXX)
    device=$(findmnt -no SOURCE / | sed 's/\[.*//')
    if mount -o subvolid=5 "$device" "$top" 2>/dev/null; then
      btrfs subvolume delete "$top/@factory" >/dev/null 2>&1 || true
      if btrfs subvolume snapshot -r "$top/@" "$top/@factory" >/dev/null; then
        step "@factory taken (read-only snapshot of the generalized root)"
      else
        step "WARNING: could not take @factory" >&2
      fi
      umount "$top"
    else
      step "WARNING: could not mount the btrfs top level; no @factory" >&2
    fi
    rmdir "$top" 2>/dev/null || true
  fi

  sync
  # fstrim before the disk is converted: every block the filesystem does not
  # use is discarded, which is what lets `qemu-img convert -c` write a small
  # image instead of a sparse-looking one full of deleted package files.
  step "trimming"
  fstrim -av 2>&1 | sed 's/^/generalize:   /' || true
  sync

  if ((poweroff)); then
    step "powering off"
    systemctl --no-block poweroff
  fi
  exit 0
fi

# ── phase 1 ─────────────────────────────────────────────────────────────────
if ((confirmed == 0)); then
  cat <<EOF
omarchy-server-generalize strips THIS machine of its identity so its disk can
be copied into a shared image. It deletes the ssh host keys, the machine-id,
the Secure Boot keys, the cloud-init state, the logs, the package cache, every
snapper snapshot, and root's password.

The machine is not usable as itself afterwards. Re-run with --yes to do it.
EOF
  exit 1
fi

echo "=== omarchy-server-generalize — $(date -Is) ==="

# --- cloud-init -------------------------------------------------------------
# `clean --logs --seed`: removes /var/lib/cloud (the per-instance state that
# makes cloud-init skip a boot it has already handled), its logs, and the
# NoCloud seed directory a lab boot may have left. Without this the image's
# first boot is cloud-init's SECOND boot and none of the once-per-instance
# modules run.
if command -v cloud-init >/dev/null; then
  step "cloud-init clean"
  cloud-init clean --logs --seed >/dev/null 2>&1 ||
    cloud-init clean --logs >/dev/null 2>&1 || true
  rm -rf /var/lib/cloud
fi

# --- the machine's own identity --------------------------------------------
# machine-id EMPTY, not absent: systemd treats an empty /etc/machine-id as
# "first boot, generate one" and a missing one as an error in some initrd
# paths. The dbus copy is a symlink into it on Arch, but an older install may
# have a real file.
step "machine-id, entropy seed and credential secret"

# The ESP is keyed by machine-id: limine-snapper-sync keeps its snapshot history
# and copies of past UKIs under /boot/<machine-id>/limine_history/. A new
# machine-id means a new tree, so the old one is dead weight in the image --
# and it is dead weight containing the build machine's kernel images. Read the
# id BEFORE truncating it, or there is nothing left to name the directory with.
old_machine_id=$(cat /etc/machine-id 2>/dev/null || true)
esp=$(sed -n 's/^[[:space:]]*ESP_PATH=["'\'']\{0,1\}\([^"'\'']*\).*/\1/p' /etc/default/limine 2>/dev/null | tail -n 1)
esp="${esp:-/boot}"
if [[ -n $old_machine_id && -d $esp/$old_machine_id ]]; then
  step "removing the build machine's boot history ($esp/$old_machine_id)"
  rm -rf "${esp:?}/${old_machine_id:?}"
fi

# The boot ENTRY in limine.conf is tagged with the machine-id too
# (`comment: machine-id=<id> order-priority=50`), and it cannot be deleted here:
# it is the entry the image boots from. So the id is handed to the first boot,
# which regenerates an entry for the machine it is actually running on and then
# removes this one. Without that step limine-snapper-sync finds no entry
# belonging to its own machine-id and silently lists no snapshots -- measured,
# and the reason this marker exists.
if [[ -n $old_machine_id ]]; then
  install -d -m 0755 "$state_dir"
  printf '%s\n' "$old_machine_id" >"$state_dir/firstboot-limine"
  step "the first boot will re-tag the limine entry (was $old_machine_id)"
fi

: >/etc/machine-id
rm -f /var/lib/dbus/machine-id
rm -f /var/lib/systemd/random-seed
rm -f /var/lib/systemd/credential.secret

step "ssh host keys (regenerated at first boot)"
rm -f /etc/ssh/ssh_host_*

# The marker omarchy-server-firstboot keeps. It has to go, or the image's first
# boot decides it is not a first boot.
rm -f "$state_dir/firstboot-done"

# --- Secure Boot ------------------------------------------------------------
# A shared image must not carry a PK/KEK/db private key: every machine booted
# from it would be able to sign kernels the others' firmware trusts. The keys
# go, the marker stays, and omarchy-server-firstboot makes a new triplet and
# enrolls it on the machine that boots this.
if [[ -d /var/lib/sbctl ]]; then
  step "Secure Boot keys (regenerated and re-enrolled at first boot)"
  rm -rf /var/lib/sbctl
  install -d -m 0755 "$state_dir"
  echo "pending" >"$state_dir/firstboot-secureboot"
fi

# --- SELinux ----------------------------------------------------------------
# A relabel is cheap on a machine whose files were just deleted and rewritten,
# and /home is created for the first time on the machine that boots the image
# -- which is exactly the case that locked an operator out in
# reports/2026-08-29-mandatory-access-control.md. Leave the flag;
# omarchy-server-selinux-relabel.service acts on it at the first boot.
if [[ -d /etc/selinux && -e /sys/fs/selinux ]]; then
  step "/.autorelabel (the first boot relabels)"
  touch /.autorelabel
fi

# --- root -------------------------------------------------------------------
# The autoinstall drive gives root a password hash, and an image is a public
# artifact: shipping one means shipping a credential that every machine from the
# image shares and that a console login would accept. Lock it. `usermod -L`
# prefixes the hash with `!`, which leaves the original recoverable from
# /etc/shadow by anyone holding the image, so the hash is REPLACED outright.
step "locking root (the image ships no password)"
usermod -p '!' root
passwd -l root >/dev/null 2>&1 || true

step "root and skeleton account traces"
rm -rf /root/.ssh
rm -f /root/.bash_history
rm -rf /root/.cache /root/.local/share/omarchy 2>/dev/null || true

# --- package cache ----------------------------------------------------------
# The whole cache, not `paccache -rk1`: an image is not going to downgrade to
# the version it shipped with, and every retained package is megabytes in an
# artifact that is uploaded and copied.
step "pacman cache"
rm -rf /var/cache/pacman/pkg/* 2>/dev/null || true
rm -rf /var/lib/pacman/sync/* 2>/dev/null || true

# --- snapper ---------------------------------------------------------------
# Every snapshot: they are of a machine that is about to stop existing, they
# are the largest thing on the disk after the package cache, and @factory
# (taken in phase 2) is the only pre-image state worth keeping.
if command -v snapper >/dev/null; then
  step "snapper snapshots"
  for config in $(snapper list-configs --columns config 2>/dev/null | tail -n +3); do
    for number in $(snapper -c "$config" list --columns number 2>/dev/null | tail -n +3 | tr -d ' '); do
      [[ $number == 0 || -z $number ]] && continue
      snapper -c "$config" delete "$number" >/dev/null 2>&1 || true
    done
  done
fi

# --- a neutral name ---------------------------------------------------------
# cloud-init sets the hostname from the metadata on every boot. This is what a
# machine with no metadata at all is called, and it must not be the name of the
# VM the image was built on.
step "hostname -> omarchy-server"
echo "omarchy-server" >/etc/hostname

# --- hand over to phase 2 ---------------------------------------------------
step "handing over to the detached phase"
# systemd-run, not `setsid ... &`: the tail has to survive the ssh session's
# cgroup being torn down when its user is deleted, and a transient unit is the
# only thing on this machine that outlives a session by construction.
args=(--yes --finish)
for account in "${remove_users[@]}"; do args+=(--remove-user "$account"); done
((remove_all_users)) && args+=(--remove-all-users)
((poweroff)) && args+=(--poweroff)
((factory)) || args+=(--no-factory)

systemd-run --unit=omarchy-server-generalize-finish --description="Omarchy Server generalize, detached phase" \
  --collect /usr/bin/omarchy-server-generalize "${args[@]}"
step "phase 2 running as omarchy-server-generalize-finish.service"
