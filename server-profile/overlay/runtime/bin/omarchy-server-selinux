#!/bin/bash

# omarchy:summary=Inspect and switch the SELinux mode of a headless server
# omarchy:args=[status|permissive|enforcing|relabel|admin-role|avc|disable]
# omarchy:examples=omarchy server-selinux status | omarchy server-selinux avc
# omarchy:requires-sudo=true

# The runtime face of the `selinux` addon. The addon leaves the machine in
# permissive: the policy is loaded, every decision is evaluated, nothing is
# refused, and the denials that WOULD have happened are in the audit log. This
# command is how that log is read (`avc`), how the machine is moved to
# enforcing once it is quiet (`enforcing`), how it is moved back if enforcing
# breaks something (`permissive`), and how the whole thing is turned off
# (`disable`).
#
# See docs/mac.md in the omarchy-server repository for the design.

set -uo pipefail

argv=("$@")

require_root() {
  if ((EUID != 0)); then
    exec sudo -E "$0" "${argv[@]}"
  fi
}

selinux_type() {
  local config=/etc/selinux/config
  [[ -r $config ]] || { printf 'refpolicy-arch'; return; }
  sed -n 's/^SELINUXTYPE=//p' "$config" | tail -n 1
}

# The Unix group whose members get the administrative SELinux role. `wheel` is
# what archinstall puts the install user in on this profile, and it is the
# group every later administrator is added to.
admin_group="${OMARCHY_SELINUX_ADMIN_GROUP:-wheel}"
sudoers_role_file=/etc/sudoers.d/omarchy-selinux-role

require_userland() {
  if ! command -v getenforce >/dev/null; then
    echo "omarchy-server-selinux: the SELinux userland is not installed." >&2
    echo "                        Run: omarchy-server-addon selinux" >&2
    exit 1
  fi
}

# Whether the kernel actually initialised SELinux this boot. /sys/fs/selinux is
# only mounted when it did, which makes this a stronger answer than reading
# /etc/selinux/config: the config says what was asked for, the mount says what
# happened.
kernel_has_selinux() {
  [[ -d /sys/fs/selinux ]]
}

# procps-ng on Arch is not built against libselinux, so `ps -Z` does not exist.
# The kernel exports the same thing per process.
#
# It can legitimately fail to answer, and quietly: in enforcing, a confined
# user domain may not read another domain's attr file, so an unprivileged
# `status` cannot report sshd's or init's context. That is the policy working,
# not a fault -- but the read error has to be swallowed and the caller has to
# say "not readable" rather than print an empty field.
process_context() { # process_context <pid>
  local file="/proc/${1:-}/attr/current"
  [[ -n ${1:-} && -r $file ]] || return 1
  tr -d '\0' <"$file" 2>/dev/null
}

# process_context, or an explanation of why not.
process_context_or_reason() { # process_context_or_reason <pid>
  local context
  if context=$(process_context "${1:-}") && [[ -n $context ]]; then
    printf '%s' "$context"
  elif ((EUID != 0)); then
    printf '(not readable from a %s session; try sudo)' \
      "$(process_context $$ | cut -d: -f3)"
  else
    printf '(unknown)'
  fi
}

cmd_status() {
  require_userland

  echo "== kernel =="
  if kernel_has_selinux; then
    echo "selinuxfs:  mounted at /sys/fs/selinux"
    echo "mode:       $(getenforce)"
    echo "policy:     $(sestatus 2>/dev/null | sed -n 's/^Loaded policy name:[[:space:]]*//p')"
  else
    echo "selinuxfs:  NOT mounted -- the kernel did not initialise SELinux this boot"
    echo "            Check that the running command line names it:"
    echo "                grep -o 'lsm=[^ ]*' /proc/cmdline"
    echo "            The drop-in that puts it there is"
    echo "            /etc/limine-entry-tool.d/omarchy-lsm-selinux.conf, and it only"
    echo "            reaches the kernel through a rebuilt UKI (limine-update)."
  fi

  echo
  echo "== configuration =="
  echo "type:       $(selinux_type)"
  if [[ -r /etc/selinux/config ]]; then
    grep -E '^(SELINUX|SELINUXTYPE)=' /etc/selinux/config
  fi
  grep -o 'lsm=[^ ]*' /proc/cmdline || echo "lsm= is not on the running command line"

  echo
  echo "== administrative role =="
  # Two halves, and one without the other is a machine that either cannot be
  # administered (mapping but no sudoers) or maps nobody (sudoers but no
  # mapping). Reported separately so a half-applied machine is visible.
  # The generated seusers, not the store's seusers.local: this command is meant
  # to be useful without sudo, and the store is root-only while
  # /etc/selinux/<type>/seusers is world-readable by design.
  local mapping
  mapping=$(grep -Ev '^[[:space:]]*(#|$)' "/etc/selinux/$(selinux_type)/seusers" 2>/dev/null)
  if [[ -n $mapping ]]; then
    sed 's/^/seusers:    /' <<<"$mapping"
  fi
  if ! grep -q ':staff_u' <<<"$mapping"; then
    echo "            NO administrative mapping. Every login is __default__, i.e."
    echo "            the confined user_u, and \`sudo\` does NOT change the SELinux"
    echo "            role -- so enforcing would be a one-way door. Fix with:"
    echo "                sudo omarchy-server-selinux admin-role"
  fi
  # /etc/sudoers.d is mode 750, so an unprivileged caller cannot answer this at
  # all. Say which of the two it is rather than reporting "absent" for both.
  if [[ -r $sudoers_role_file ]]; then
    grep -Ev '^[[:space:]]*(#|$)' "$sudoers_role_file" | sed 's/^/sudoers:    /'
  elif ((EUID == 0)); then
    echo "sudoers:    $sudoers_role_file is absent"
  else
    echo "sudoers:    (not readable without root)"
  fi
  # The addon leaves this flag deliberately, and
  # omarchy-server-selinux-relabel.service clears it on the first boot. Seeing
  # it on a machine that has booted means that unit did not finish, and a
  # relabel is OWED -- which is one of the things `enforcing` refuses over.
  [[ -f /.autorelabel ]] && echo "/.autorelabel is present: the first-boot relabel has not completed"

  if kernel_has_selinux; then
    echo
    echo "== this session =="
    echo "shell:      $(process_context $$)"
    echo "sshd:       $(process_context_or_reason "$(pgrep -x sshd | head -1)")"
    echo "init:       $(process_context_or_reason 1)"

    echo
    echo "== local policy modules =="
    # The policy store is root-only, so an unprivileged caller cannot tell
    # "no omarchy module" from "cannot look" -- and reporting the first when it
    # is the second is exactly the kind of quiet wrong answer this command
    # exists to avoid.
    if ((EUID != 0)); then
      echo "(the policy store is not readable without root; try sudo)"
    else
      semodule -s "$(selinux_type)" -l 2>/dev/null | grep -E '^omarchy' ||
        echo "(none named omarchy*)"
    fi
  fi
}

# The denial record. Two sources, because a server may or may not be running
# auditd: auditd writes /var/log/audit/audit.log and `ausearch` reads it; with
# no auditd the kernel's audit messages land in the journal instead. The
# journal path is the one this profile expects, since the base installs no
# audit daemon.
cmd_avc() {
  require_userland
  local since=${1:-boot}

  echo "== AVC denials since $since =="
  if command -v ausearch >/dev/null && [[ -r /var/log/audit/audit.log ]]; then
    ausearch -m AVC,USER_AVC,SELINUX_ERR -ts "$since" -i 2>/dev/null ||
      echo "(none in the audit log)"
    return
  fi

  local lines
  lines=$(journalctl -k --no-pager -b -g 'avc: *denied' -o cat 2>/dev/null)
  if [[ -z $lines ]]; then
    echo "(none in this boot's kernel log)"
    return
  fi

  echo "$lines"
  echo
  echo "== summary: count, source domain, target context, class, permissions =="
  # The fields are unordered key=value pairs, so pick them by name rather than
  # by position. Sorted by count, because the same denial repeated four hundred
  # times is one thing to fix.
  awk '
    {
      scontext = tcontext = tclass = perms = "?"
      if (match($0, /\{ [^}]* \}/))  perms    = substr($0, RSTART + 2, RLENGTH - 4)
      for (i = 1; i <= NF; i++) {
        split($i, kv, "=")
        if (kv[1] == "scontext") scontext = kv[2]
        if (kv[1] == "tcontext") tcontext = kv[2]
        if (kv[1] == "tclass")   tclass   = kv[2]
      }
      key = scontext " -> " tcontext " : " tclass " { " perms " }"
      count[key]++
    }
    END { for (k in count) printf "%6d  %s\n", count[k], k }
  ' <<<"$lines" | sort -rn

  echo
  echo "To turn these into a policy module (audit2allow is in the"
  echo "\`selinux-tools\` addon, and does not have to be on this machine):"
  echo "    journalctl -k -b -g 'avc: *denied' -o cat | audit2allow -m omarchy_server_local"
  echo "Read what it produces before installing it. A rule that allows a denial"
  echo "the machine should not have made is a hole, not a fix."
}

# The guard that turns a lockout into a refusal.
#
# Measured: a machine whose /home/<user> was still unlabeled went enforcing and
# the operator's session lost access to its own home directory -- and with it
# to `sudo`, since the wrapper it needed lived there. Nothing could be undone
# from inside afterwards, and the kernel command line is inside a signed UKI,
# so `enforcing=0` cannot be added at the Limine menu either.
#
# Four conditions, checked before enforcing. --force is the way past them for
# somebody who has read them and has console access.

# `find -context` needs a findutils linked against libselinux, and this profile
# does not install one: findutils-selinux is deliberately not in the rebuild set
# (omarchy-server-pkgs/pkgbuilds/selinux.manifest says why). On a machine
# without it the option is a usage error, and a guard that silently finds
# nothing is worse than no guard -- so ask first, and fall back if the answer
# is no.
find_has_context() {
  find /etc -maxdepth 0 -context '*' >/dev/null 2>&1
}

# The check that does not need find at all, and covers the exact paths the
# lockout was about. `ls -Zd` is coreutils-selinux, which this addon installs
# by construction. An unlabeled or context-less home directory is the one
# failure that cannot be recovered from over ssh.
home_labels_problem() {
  local path context problems=()
  for path in /root /home /home/*; do
    [[ -d $path ]] || continue
    context=$(ls -Zd "$path" 2>/dev/null | awk '{print $1}')
    case "$context" in
      *unlabeled_t* | '?' | '') problems+=("$path is $context") ;;
    esac
  done
  ((${#problems[@]})) || return 0
  printf '%s\n' "${problems[@]}"
}

# Is there a way BACK from enforcing on this session?
#
# Only sysadm_r and secadm_r are granted `security { setenforce }`; user_r
# reaches neither, and `runcon -t sysadm_t` from user_r answers "invalid
# context". So on a machine with refpolicy's default mapping this answers no,
# and it is right to: measured, `sudo omarchy-server-selinux permissive` under
# enforcing failed with
#
#     setenforce: security_setenforce() failed: Permission denied
#
# because sudo gave Unix root and left the SELinux context alone. Every way
# back then needed console access, which a remote operator does not have.
#
# `omarchy-server-selinux admin-role` is what makes this answer yes, and it is
# applied by the addon at install time: %wheel is mapped to staff_u in seusers
# and sudoers carries `role=sysadm_r, type=sysadm_t`, so this command -- which
# re-execs itself under sudo in require_root -- is already running as
# staff_u:sysadm_r:sysadm_t by the time the check is made. That is the honest
# form of the question: not "is the machine configured" but "can THIS process,
# the one about to call setenforce, call it again afterwards".
session_can_return() {
  local context role
  context=$(process_context $$)
  role=$(cut -d: -f2 <<<"$context")
  case "$role" in
    sysadm_r | secadm_r | unconfined_r) return 0 ;;
    *) return 1 ;;
  esac
}

enforcing_preflight() {
  local unlabeled avc_lines lockout_avc other_avc homes init_context problems=()

  # 1. a relabel that is owed and has not run. The addon leaves this flag for
  #    the first-boot unit; if it is still here that unit did not finish.
  if [[ -f /.autorelabel ]]; then
    problems+=("/.autorelabel is present: the first-boot relabel has not completed")
  fi

  # 2. the home directories, always checkable, and the exact thing that caused
  #    the lockout this guard exists for.
  homes=$(home_labels_problem)
  if [[ -n $homes ]]; then
    while read -r line; do problems+=("$line"); done <<<"$homes"
  fi

  # 3. PID 1's domain. init transitions to init_t at exec only if
  #    /usr/lib/systemd/systemd already carried init_exec_t when it ran, so a
  #    machine still showing kernel_t booted against an incomplete label set --
  #    which is precisely the state that locks the operator out. On a fresh
  #    install that is the FIRST boot, before the relabel unit has run and
  #    before the reboot that picks its work up.
  init_context=$(process_context 1)
  if [[ $init_context != *:init_t* ]]; then
    problems+=("init is $init_context, not init_t: this boot happened before the")
    problems+=("    labels were complete. Reboot, then try again.")
  fi

  # 4. the wider label sweep, when this machine can do it.
  if find_has_context; then
    unlabeled=$(find /home /root /etc /usr /var -xdev -context '*unlabeled_t*' 2>/dev/null)
    if [[ -n $unlabeled ]]; then
      problems+=("$(wc -l <<<"$unlabeled") unlabeled paths, the first of them:")
      while read -r path; do problems+=("    $path"); done < <(head -5 <<<"$unlabeled")
    fi
  fi

  # 5. can this session undo the switch it is about to make.
  if ! session_can_return; then
    problems+=("this session runs as $(process_context $$), and that role cannot")
    problems+=("    setenforce. Going enforcing from here is a ONE-WAY door:")
    problems+=("    \`sudo omarchy-server-selinux permissive\` will be refused by the")
    problems+=("    policy afterwards, and every way back needs console access.")
    problems+=("    Give this machine an administrative role first:")
    problems+=("        sudo omarchy-server-selinux admin-role")
    problems+=("    then log in again and check \`sudo id -Z\` says sysadm_t.")
    problems+=("    Use --force only from a console you can still reach.")
  fi

  # 6. the denial record, split in two.
  #
  # An earlier version of this guard refused over ANY denial this boot. That
  # was measured and it is unusable: the Arch reference policy is refpolicy
  # 20250923 and this profile runs systemd 261, so a bare boot of a correctly
  # labelled machine produces on the order of eighteen denials from systemd
  # mechanisms the policy has not been taught -- credentials on tmpfs, PSI,
  # varlink, userdb, BPF. Closing them is an open-ended job, not a
  # precondition, and a gate nobody can ever satisfy is a gate everybody
  # passes with --force.
  #
  # What matters for THIS guard is narrower and does not move: can the
  # operator still get in and still become root. So the denials are split.
  #
  # BLOCKING -- a wrong label, or a refusal somewhere on the way back in:
  #   * anything whose target is unlabeled_t. That is the lockout, exactly.
  #   * anything raised by the login path: sshd, login, the getty, sudo, and
  #     the user role itself (user_r). If any of those is already being
  #     refused in permissive, enforcing turns it into a locked door.
  #
  # WARNING -- everything else. Listed with counts, because a service that
  # stops working in enforcing is a real cost and the operator should see the
  # list before choosing; but it is a service outage, recoverable over the ssh
  # session this guard just protected.
  avc_lines=$(journalctl -k --no-pager -b -g 'avc: *denied' -o cat 2>/dev/null)
  if [[ -n $avc_lines ]]; then
    lockout_avc=$(grep -E 'tcontext=[^ ]*unlabeled_t|scontext=[^ ]*:(user_r|sysadm_r):|scontext=[^ ]*:(sshd_t|local_login_t|getty_t|sudo_t|user_sudo_t|sysadm_sudo_t)' <<<"$avc_lines")
    other_avc=$(grep -cvE 'tcontext=[^ ]*unlabeled_t|scontext=[^ ]*:(user_r|sysadm_r):|scontext=[^ ]*:(sshd_t|local_login_t|getty_t|sudo_t|user_sudo_t|sysadm_sudo_t)' <<<"$avc_lines")

    if [[ -n $lockout_avc ]]; then
      problems+=("$(wc -l <<<"$lockout_avc") denials on the login/sudo path or against an")
      problems+=("    unlabeled target. These are the ones that lock you out:")
      while read -r line; do
        problems+=("    ${line:0:150}")
      done < <(head -3 <<<"$lockout_avc")
    fi

    if ((other_avc > 0)); then
      echo "omarchy-server-selinux: $other_avc denials this boot are NOT on the login" >&2
      echo "                        path. Enforcing will turn each of them into a" >&2
      echo "                        refusal, which may break the service that made it." >&2
      echo "                        Read them first:  omarchy-server-selinux avc" >&2
      echo >&2
    fi
  fi

  ((${#problems[@]})) || return 0

  echo "omarchy-server-selinux: refusing to enforce." >&2
  printf '  - %s\n' "${problems[@]}" >&2
  echo >&2
  echo "  Enforcing on a machine in this state locks the operator out: user_t may" >&2
  echo "  not search unlabeled_t, so a login session cannot reach its own home" >&2
  echo "  directory, and sudo goes with it." >&2
  echo >&2
  echo "  Fix the labels first:" >&2
  echo "      sudo omarchy-server-selinux relabel" >&2
  echo "  then reboot, so init and every service start against the new labels," >&2
  echo "  and re-read the denial list on the boot that follows." >&2
  echo >&2
  echo "  --force skips this check. Only from a console you can still reach." >&2
  return 1
}

set_mode() { # set_mode <permissive|enforcing> [--force]
  require_root
  require_userland

  local mode=$1 value config
  case "$mode" in
    permissive) value=0 ;;
    enforcing) value=1 ;;
  esac

  if [[ $mode == enforcing && ${2:-} != --force ]]; then
    enforcing_preflight || exit 1
  fi

  if ! kernel_has_selinux; then
    echo "omarchy-server-selinux: SELinux is not active in this kernel." >&2
    echo "                        The mode is recorded for the next boot anyway." >&2
  elif ! setenforce "$value"; then
    echo "omarchy-server-selinux: setenforce failed." >&2
    exit 1
  fi

  # The running mode is not enough: /etc/selinux/config is what the next boot
  # reads, and a machine that goes back to permissive on reboot has not been
  # switched.
  config=$(readlink -f /etc/selinux/config 2>/dev/null)
  if [[ -w $config ]]; then
    sed -i "s/^SELINUX=.*/SELINUX=$mode/" "$config"
  fi

  echo "SELinux is now $mode, and $mode on the next boot."
  if [[ $mode == enforcing ]]; then
    echo
    echo "If this locks something out, the ways back, in order:"
    if session_can_return; then
      echo "  1. from this session, which has a role that may setenforce:"
      echo "         sudo omarchy-server-selinux permissive"
    else
      echo "  NOT from an ssh session. This machine has no administrative"
      echo "  SELinux role: sudo does not change the role, and user_r is not"
      echo "  granted security { setenforce } -- so"
      echo "  \`omarchy-server-selinux permissive\` will be refused by the policy"
      echo "  from here on. Measured, not assumed. See \`admin-role\`."
    fi
    echo "  * boot the previous snapper snapshot from the Limine menu and"
    echo "    undo it there. The profile keeps five."
    echo "  * boot the installer medium, mount the root subvolume and set"
    echo "    SELINUX=permissive in its /etc/selinux/config."
    echo
    echo "NOT the kernel command line. \`enforcing=0\` cannot be added at the"
    echo "Limine menu on this profile: the cmdline lives inside the UKI, and a"
    echo "UKI entry ignores the \`cmdline:\` in limine.conf."
  fi
}

# ── the administrative role ─────────────────────────────────────────────────
#
# The problem this solves, measured before it was designed: with the reference
# policy's default mapping (`__default__:user_u`) the operator logs in as
# user_u:user_r:user_t and `sudo` gives Unix root WITHOUT changing the SELinux
# context. In enforcing that leaves an administrator who cannot run pacman, ufw
# or systemctl, and -- because only sysadm_r and secadm_r are granted
# `security { setenforce }` -- cannot switch back to permissive either. See
# reports/2026-08-29-mandatory-access-control.md §10.6.
#
# The arrangement, which is refpolicy's own and needs no policy change for the
# role transition itself:
#
#   seusers   %wheel:staff_u -- members of the sudo group are the SELinux user
#             staff_u. `__default__` stays user_u, so a service account or an
#             unprivileged login is still confined exactly as before. staff_u
#             is authorised for BOTH staff_r and sysadm_r by refpolicy's own
#             users file (`user staff_u roles { staff_r sysadm_r }`), and
#             `allow staff_r sysadm_r` is already in the policy.
#
#   login     stays staff_u:staff_r:staff_t. staff_t is an UNPRIVILEGED user
#             domain -- it is in the unpriv_userdomain attribute, which is why
#             sshd may transition into it with ssh_sysadm_login off. So the
#             session an attacker reaches by stealing an ssh key is still a
#             confined one; the administrative domain is one authenticated
#             sudo away, not one login away.
#
#   sudo      Defaults:%wheel role=sysadm_r, type=sysadm_t. sudo (built with
#             SELinux support -- sudo-selinux is in this profile's rebuild set)
#             calls setexeccon, and the command runs as
#             staff_u:sysadm_r:sysadm_t.
#
# Why NOT map the operator to sysadm_u directly, which is the other textbook
# option: sysadm_u is authorised for sysadm_r ONLY, so the LOGIN SHELL would be
# sysadm_t. Everything the operator does over ssh -- reading mail, running a
# build, opening a file someone sent them -- would run in the domain that may
# load policy and set enforcing, and the confinement of the interactive session
# would be gone. It would also require ssh_sysadm_login=on, which is a boolean
# this arrangement does not need. staff_u keeps the two apart.
#
# Idempotent, and safe to re-run: both files are rewritten whole.
cmd_admin_role() { # cmd_admin_role [--defer-rebuild] [--group NAME] [user...]
  require_root
  require_userland

  local defer=0 users=() type store seusers tmp entry
  while (($#)); do
    case "$1" in
      --defer-rebuild) defer=1; shift ;;
      --group) admin_group="$2"; shift 2 ;;
      -*)
        echo "omarchy-server-selinux admin-role: unknown option '$1'" >&2
        exit 2
        ;;
      *) users+=("$1"); shift ;;
    esac
  done

  type=$(selinux_type)
  store="/var/lib/selinux/$type/active"
  seusers="$store/seusers.local"

  if [[ ! -d $store ]]; then
    echo "omarchy-server-selinux: no policy store at $store." >&2
    echo "                        Run: omarchy-server-addon selinux" >&2
    exit 1
  fi

  # seusers.local, written directly rather than through `semanage login`, for
  # the same reason file_contexts.local is: semanage lives in selinux-python,
  # which together with setools is 45 packages and 453 MiB of scientific Python
  # and belongs to the separate `selinux-tools` addon. This is the same file in
  # the same place and the same format; `semodule -B` merges it into the store's
  # seusers and regenerates /etc/selinux/<type>/seusers from it.
  #
  # A `%group` entry is resolved by libselinux at login through getgrnam, and it
  # is checked AFTER an exact username match and BEFORE __default__. If the
  # group cannot be resolved the lookup falls through to __default__, i.e. to
  # the confined user_u -- the failure direction is "less privilege", which is
  # the right way round for a file that decides who may administer the machine.
  {
    echo "# Written by omarchy-server-selinux admin-role."
    echo "# Members of the '$admin_group' group are the SELinux user staff_u,"
    echo "# which is authorised for staff_r (their login) and sysadm_r (sudo)."
    printf '%%%s:staff_u\n' "$admin_group"
    for entry in "${users[@]}"; do printf '%s:staff_u\n' "$entry"; done
  } >"$seusers"
  chmod 600 "$seusers"
  echo "selinux: seusers.local maps %$admin_group${users:+ and ${users[*]}} to staff_u"

  # The sudoers drop-in. Validated into place rather than written into place:
  # a sudoers file that does not parse is ignored with a syntax error on every
  # subsequent sudo, and this one is being installed by a command whose whole
  # purpose is to keep the operator able to become root.
  tmp=$(mktemp)
  chmod 0440 "$tmp"
  {
    echo "# Written by omarchy-server-selinux admin-role."
    echo "#"
    echo "# sudo changes the SELinux role as well as the Unix identity: a member"
    echo "# of '$admin_group' logs in as staff_u:staff_r:staff_t and runs sudo as"
    echo "# staff_u:sysadm_r:sysadm_t. Without this line sudo gives Unix root and"
    echo "# leaves the confined user context in place, which in enforcing means"
    echo "# pacman, ufw, systemctl and setenforce are all refused."
    printf 'Defaults:%%%s role=sysadm_r, type=sysadm_t\n' "$admin_group"
  } >"$tmp"

  if ! visudo -cqf "$tmp"; then
    echo "omarchy-server-selinux: the sudoers drop-in did not parse; not installed." >&2
    rm -f "$tmp"
    exit 1
  fi
  install -m 0440 -o root -g root "$tmp" "$sudoers_role_file"
  rm -f "$tmp"
  echo "selinux: $sudoers_role_file installed (role=sysadm_r type=sysadm_t for %$admin_group)"

  if ((defer)); then
    echo "selinux: the store rebuild is deferred to the caller"
    return 0
  fi

  # The store rebuild is what turns seusers.local into the seusers the kernel
  # side reads, and it also re-runs genhomedircon -- which now names the
  # administrator's home directory under the staff_u identity instead of the
  # generic user_u one.
  echo "selinux: rebuilding the policy store"
  if ! semodule -s "$type" -B; then
    echo "omarchy-server-selinux: semodule -B failed; the mapping is not active." >&2
    exit 1
  fi

  # And the identity on disk follows. The TYPE does not change -- refpolicy has
  # one user_home_dir_t for every unprivileged user, not one per prefix -- so
  # this is not what makes the home directory reachable; UBAC is off in
  # refpolicy-arch (the ubac_constrained_type attribute has no members), so the
  # user field of a file context does not gate access here either. It is done
  # because leaving the disk disagreeing with the policy is what the label-drift
  # check reports, and a check that is noisy is a check nobody reads.
  #
  # The policy store itself is relabelled for a different and less cosmetic
  # reason. `semodule -B` regenerates a dozen files under
  # /var/lib/selinux/<type> and /etc/selinux/<type>, and it may NOT set their
  # context: relabelling policy_config_t is a refpolicy neverallow, and the
  # rest fail the identity constraint because this process is the
  # administrator's staff_u and the context the files want is system_u. So they
  # come out with the right type under the wrong identity. setfiles_t may do
  # what semanage_t may not; one restorecon puts it right, and leaves the label
  # drift check clean. omarchy_server.te §22 has the whole reasoning.
  if [[ -d /sys/fs/selinux ]]; then
    restorecon -R -F "/var/lib/selinux/$type" "/etc/selinux/$type" 2>/dev/null || true
    [[ -d /home ]] && restorecon -R -F /home /root 2>/dev/null || true
  fi

  echo
  echo "The mapping takes effect on the NEXT login -- an existing session keeps"
  echo "the context it was given. Verify from a fresh one:"
  echo "    id -Z          # expect ...:staff_r:staff_t"
  echo "    sudo id -Z     # expect ...:sysadm_r:sysadm_t"
}

cmd_relabel() {
  require_root
  require_userland

  local type dir
  type=$(selinux_type)
  dir="/etc/selinux/$type/contexts/files"

  if [[ ! -f $dir/file_contexts ]]; then
    echo "omarchy-server-selinux: no file_contexts for policy '$type'." >&2
    exit 1
  fi
  # No `semodule -B` here, deliberately. It is tempting -- the addon runs in the
  # install chroot, where the operator's account does not exist yet, so
  # genhomedircon can only emit the generic /home/[^/]+ entries under the
  # default identity, and rebuilding on the first boot would expand the
  # administrative role's %wheel mapping to the real account. It was tried and
  # reverted: the only thing it changes is the USER field of the home
  # directory's context (user_u -> staff_u), the type is user_home_dir_t either
  # way, refpolicy-arch has UBAC off so the user field gates nothing, and the
  # rebuild drags semanage_t into the relabel path with a statfs of every
  # mounted filesystem behind it. `admin-role` rebuilds the store and relabels
  # /home itself, which is where that work belongs.
  if [[ ! -s $dir/file_contexts.homedirs ]]; then
    echo "omarchy-server-selinux: WARNING -- file_contexts.homedirs is missing or" >&2
    echo "                        empty, so nothing here labels /home/<user>, and" >&2
    echo "                        an unlabeled home is what locks the operator out." >&2
    echo "                        Regenerate it with: semodule -s $type -B" >&2
  fi

  echo "Relabelling the filesystem against $type. This takes a few minutes."
  # restorecon, not setfiles. libselinux loads file_contexts,
  # file_contexts.homedirs and file_contexts.local -- in that precedence order
  # -- when it opens the store by policy type, and only the named file when it
  # is handed a path, which setfiles requires. The /home/[^/]+ ->
  # user_home_dir_t entry lives in homedirs and this profile's own
  # /usr/share/omarchy/bin rule lives in local, so a plain setfiles relabel
  # applied neither; that was half of the lockout in
  # reports/2026-08-29-mandatory-access-control.md. Concatenating the three for
  # setfiles does not work either -- they legitimately disagree about
  # /root/.k5login, which libselinux resolves by precedence and setfiles
  # rejects outright.
  if ! restorecon -R -F -i \
    -e /dev -e /proc -e /sys -e /run -e /tmp -e /var/lib/machines -e /.snapshots /; then
    echo "omarchy-server-selinux: restorecon reported errors; /.autorelabel is kept" >&2
    exit 1
  fi

  # An exit status is not evidence that the rules took. A spec line whose
  # context the policy rejects is DROPPED, and the tool still exits 0 -- which
  # is how a four-field context in file_contexts.local left
  # /usr/share/omarchy/bin unlabeled through two relabels. Check the disk.
  local unlabeled
  unlabeled=$(ls -Zd /home /home/* /root /usr/share/omarchy/bin 2>/dev/null |
    grep -E 'unlabeled_t|^\?' || true)
  if [[ -n $unlabeled ]]; then
    echo "omarchy-server-selinux: the relabel ran but these are still unlabeled:" >&2
    echo "$unlabeled" >&2
    echo "                        /.autorelabel is kept. Check" >&2
    echo "                        $dir/file_contexts.local for a context this" >&2
    echo "                        policy rejects (this policy is not MLS: a" >&2
    echo "                        context has three fields, no :s0)." >&2
    exit 1
  fi

  rm -f /.autorelabel
  echo "Done. A reboot is not required, but is the cleanest way to pick up the"
  echo "new labels in every already-running process."
}

# Removing the cmdline drop-in and rebuilding the UKI is the whole of turning
# SELinux off: the packages can stay, and on the next boot the kernel simply
# does not initialise the module. Uninstalling the replacement packages is a
# separate, much riskier operation and is deliberately not automated here.
cmd_disable() {
  require_root

  rm -f /etc/limine-entry-tool.d/omarchy-lsm-selinux.conf
  echo "Removed /etc/limine-entry-tool.d/omarchy-lsm-selinux.conf"

  # The sudoers role drop-in goes with it. sudo ignores role= and type= when
  # the kernel has no SELinux, so leaving it would be harmless -- but a machine
  # that says it is not running SELinux should not carry a sudoers file that
  # only makes sense under one. The seusers mapping stays: it lives in the
  # policy store, which this command does not touch, and is inert with the
  # module off.
  if [[ -e $sudoers_role_file ]]; then
    rm -f "$sudoers_role_file"
    echo "Removed $sudoers_role_file"
  fi

  if command -v limine-update >/dev/null; then
    limine-update
  else
    echo "limine-update is not installed; rebuild the boot entry by hand." >&2
  fi

  echo
  echo "SELinux will not initialise on the next boot."
  echo "The packages are still installed. They are a superset of the stock ones"
  echo "and are harmless with the module off; removing them means putting Arch's"
  echo "systemd, coreutils, util-linux, shadow, sudo, openssh and pam back with"
  echo "  sudo pacman -S --ask=4 systemd systemd-libs systemd-sysvcompat \\"
  echo "      coreutils util-linux shadow sudo openssh pam pambase"
}

usage() {
  echo "Usage: omarchy-server-selinux <command>"
  echo
  echo "  status              is the policy loaded, in which mode, with what labels"
  echo "  avc [since]         the denials this boot (or since a timestamp), summarised"
  echo "  permissive          evaluate and log, refuse nothing (now and at boot)"
  echo "  enforcing [--force] refuse what the policy does not allow (now and at boot)."
  echo "                      Refuses if the labels or the denial log say the"
  echo "                      machine would lock itself out; --force overrides."
  echo "  relabel             re-apply file contexts across the filesystem"
  echo "  admin-role [user…]  give the sudo group an administrative SELinux role:"
  echo "                      %wheel logs in as staff_t and sudo reaches sysadm_t."
  echo "                      Without it, enforcing is a one-way door over ssh."
  echo "                      --group NAME uses another group; extra arguments are"
  echo "                      user names mapped to staff_u on their own."
  echo "  disable             stop initialising SELinux at boot, keep the packages"
}

case "${1:-status}" in
  status) cmd_status ;;
  avc) shift; cmd_avc "$@" ;;
  permissive) set_mode permissive ;;
  enforcing) shift; set_mode enforcing "${1:-}" ;;
  relabel) cmd_relabel ;;
  admin-role) shift; cmd_admin_role "$@" ;;
  disable) cmd_disable ;;
  -h | --help | help) usage ;;
  *)
    echo "omarchy-server-selinux: unknown command '$1'. Try --help." >&2
    exit 2
    ;;
esac
