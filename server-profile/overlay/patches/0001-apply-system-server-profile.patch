# Route omarchy-apply-system through install/server/all.sh when the active
# profile is 'server' (OMARCHY_PROFILE env or /etc/omarchy-profile).
# Everything else — argument parsing, the exported environment, logging,
# and the whole desktop path — is untouched.
--- a/bin/omarchy-apply-system	2026-08-28 19:05:44.787994582 -0300
+++ b/bin/omarchy-apply-system	2026-08-28 19:05:53.704544439 -0300
@@ -85,18 +85,36 @@
 export OMARCHY_INSTALL_LOG_FILE="${OMARCHY_INSTALL_LOG_FILE:-/var/log/omarchy-install.log}"
 export PATH="$OMARCHY_PATH/bin:$PATH"
 
+# The profile decides which setup tree runs. It comes from the environment
+# (the ISO exports OMARCHY_PROFILE) or from /etc/omarchy-profile, written into
+# the target by the server profile of the ISO. Anything other than "server"
+# keeps the stock desktop path.
+profile="${OMARCHY_PROFILE:-}"
+if [[ -z $profile && -r /etc/omarchy-profile ]]; then
+  profile=$(tr -d '[:space:]' </etc/omarchy-profile)
+fi
+export OMARCHY_PROFILE="$profile"
+
 source "$OMARCHY_INSTALL/helpers/logging.sh"
 start_install_log
 
-source "$OMARCHY_INSTALL/config/all.sh"
-
-if (( defer_provisioning )); then
-  omarchy-apply-hardware --defer-provisioning
+if [[ $profile == "server" ]]; then
+  # install/server/all.sh replaces config/all.sh, omarchy-apply-hardware
+  # (38 of its 40 scripts are laptop/GPU/audio fixes), login/all.sh (no
+  # display manager) and post-install/all.sh, whose pacman step needs a
+  # server variant.
+  source "$OMARCHY_INSTALL/server/all.sh"
 else
-  omarchy-apply-hardware --install-user "$install_user"
-fi
+  source "$OMARCHY_INSTALL/config/all.sh"
+
+  if (( defer_provisioning )); then
+    omarchy-apply-hardware --defer-provisioning
+  else
+    omarchy-apply-hardware --install-user "$install_user"
+  fi
 
-source "$OMARCHY_INSTALL/login/all.sh"
-source "$OMARCHY_INSTALL/post-install/all.sh"
+  source "$OMARCHY_INSTALL/login/all.sh"
+  source "$OMARCHY_INSTALL/post-install/all.sh"
+fi
 
 stop_install_log
