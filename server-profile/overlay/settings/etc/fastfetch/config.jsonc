{
  // Server MOTD. Dropped from the desktop config: gpu, display, wm, de,
  // terminal, terminalfont, wmtheme and the omarchy-theme-current line —
  // none of them have an answer on a headless machine, and fastfetch prints
  // an error placeholder for each.
  // Added: local ip and the shell, which are what one actually wants after
  // sshing in.
  //
  // The logo is read from /usr/share/omarchy/logo.txt, not from the copy under
  // ~/.config: this file is the machine-wide MOTD, and root, a service account
  // and a user created after the package was installed all have to render it.
  // Only the runtime package's own path is guaranteed to be there.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/omarchy/logo.txt",
    "color": { "1": "green" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "[90m┌──────────────────────Hardware──────────────────────┐"
    },
    { "type": "host", "key": " PC", "keyColor": "green" },
    { "type": "cpu", "key": "│ ├", "showPeCoreCount": true, "keyColor": "green" },
    { "type": "disk", "key": "│ ├󰋊", "keyColor": "green" },
    { "type": "memory", "key": "│ ├", "keyColor": "green" },
    { "type": "swap", "key": "└ └󰓡 ", "keyColor": "green" },
    {
      "type": "custom",
      "format": "[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "[90m┌──────────────────────Software──────────────────────┐"
    },
    // PRETTY_NAME straight out of /etc/os-release, which
    // omarchy-server-settings generates from pkgver ("Omarchy Server 4.0.1").
    // The previous shell-out to omarchy-version said the same thing at the
    // cost of a pacman query on every login.
    { "type": "os", "key": " OS", "keyColor": "blue" },
    { "type": "kernel", "key": "│ ├", "keyColor": "blue" },
    { "type": "shell", "key": "│ ├", "keyColor": "blue" },
    { "type": "packages", "key": "│ ├󰏖", "keyColor": "blue" },
    { "type": "localip", "key": "└ └󰩟", "keyColor": "blue" },
    {
      "type": "custom",
      "format": "[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    { "type": "uptime", "key": "󱫐 Uptime", "keyColor": "magenta" },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      // Pending updates read out of the local sync database. `pacman -Qu` is a
      // database query with no network call, unlike checkupdates, which
      // downloads a fresh database into a temporary dbpath -- not something to
      // put on the login path of a machine that may be on a metered link.
      "type": "command",
      "key": "󰚰 Pending",
      "keyColor": "magenta",
      "text": "n=$(pacman -Qu 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"$n package(s)\" || echo none"
    },
    {
      "type": "custom",
      "format": "[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
